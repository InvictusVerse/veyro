!gradle/wrapper/gradle-wrapper.jar

# Signing material must never be committed
*.jks
*.keystore
keystore.properties
signing.properties

# ---------- IDE ----------
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/
*.iml
.kotlin/
out/

# ---------- .NET / Windows ----------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
artifacts/
*.nupkg
publish/

# ---------- OS ----------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------- Project-local scratch ----------
/scratch/
/test/
*.log
*.tmp
# JVM heap dumps from out-of-memory Gradle daemons (hundreds of MB)
*.hprof
# Per-machine Kiro settings (MCP config may hold tokens)
.kiro/settings/
# Third-party agent plugins and skills: tooling, not Veyro source
/.agents/
/.kiro/skills/
# Session handoff notes are per-session working files
/HANDOFF*.md
/.handoffs/

# ProjectInfo is the private working knowledge base: never versioned.
/ProjectInfo/
# Partially received files and their resume sidecars must never be committed
*.veyropart
*.veyrometa
