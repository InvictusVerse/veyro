<UserControl
    x:Class="Veyro.UserControls.ActiveTransferBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!--  ADR-038: a completed transfer slides out on its own; failures stay until dismissed.  -->
        <Storyboard x:Name="SlideOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="BannerTransform"
                Storyboard.TargetProperty="TranslateX"
                From="0"
                To="64"
                Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="BannerCard"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.28" />
        </Storyboard>
    </UserControl.Resources>

    <!--  Only the running or last outbound transfer. Figures are measured, never estimated ahead of data.  -->
    <Border
        x:Name="BannerCard"
        MaxWidth="640"
        Margin="24,12,24,8"
        Padding="16,12"
        HorizontalAlignment="Stretch"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.IsBannerVisible, Mode=OneWay}">
        <Border.RenderTransform>
            <CompositeTransform x:Name="BannerTransform" />
        </Border.RenderTransform>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                Margin="0,2,0,0"
                VerticalAlignment="Top"
                FontSize="20"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="{x:Bind ViewModel.BannerGlyph, Mode=OneWay}" />

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BannerStage, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Margin="0,4"
                    Maximum="1.0"
                    Minimum="0.0"
                    Visibility="{x:Bind ViewModel.IsTransferRunning, Mode=OneWay}"
                    Value="{x:Bind ViewModel.BannerProgress, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BannerProgressText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.BannerError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasBannerError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    Click="CancelTransfer_Click"
                    Content="Cancel"
                    Visibility="{x:Bind ViewModel.IsTransferRunning, Mode=OneWay}" />
                <!--  Always there: dismisses a finished banner, hides a running one.  -->
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.DismissLabel, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="Dismiss_Click"
                    ToolTipService.ToolTip="{x:Bind ViewModel.DismissLabel, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
