<UserControl
    x:Class="Veyro.UserControls.ActiveTransferBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Only the running or last outbound transfer. Figures are measured, never estimated ahead of data.  -->
    <Border
        Margin="16,8,16,8"
        Padding="16,10"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Visibility="{x:Bind ViewModel.HasActiveTransfer, Mode=OneWay}">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="20"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Glyph="{x:Bind ViewModel.BannerGlyph, Mode=OneWay}" />

            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BannerStage, Mode=OneWay}" />
                <ProgressBar
                    Maximum="1.0"
                    Minimum="0.0"
                    Visibility="{x:Bind ViewModel.IsTransferRunning, Mode=OneWay}"
                    Value="{x:Bind ViewModel.BannerProgress, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.BannerProgressText, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.BannerError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasBannerError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                <Button
                    AutomationProperties.Name="Cancel transfer"
                    Click="CancelTransfer_Click"
                    ToolTipService.ToolTip="Cancel transfer"
                    Visibility="{x:Bind ViewModel.IsTransferRunning, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
                <Button
                    AutomationProperties.Name="Dismiss"
                    Click="Dismiss_Click"
                    Content="Dismiss"
                    Visibility="{x:Bind ViewModel.IsTransferFinished, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
