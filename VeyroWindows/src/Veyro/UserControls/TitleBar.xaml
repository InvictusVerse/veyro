<UserControl
    x:Class="Veyro.UserControls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Drag area content for the extended title bar: app mark and name on a 32 px strip.  -->
    <StackPanel
        Height="32"
        Padding="10,0,0,0"
        Orientation="Horizontal"
        Spacing="8">
        <Image
            Width="18"
            Height="18"
            VerticalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw">
            <Image.Source>
                <BitmapImage UriSource="{ThemeResource IconPath}" />
            </Image.Source>
        </Image>
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="Veyro" />
    </StackPanel>
</UserControl>
