<!--
    The phone's notifications in the sidebar (ADR-025, ADR-063).

    Cards come from NotificationMirrorService. Dismiss, reply and the phone's own action buttons
    go back to the phone. A card's small tools (pop-up rules, dismiss) show while the pointer is
    on it or when one of them has keyboard focus. "Earlier" lists what left the phone in the last
    24 hours; those cards are read-only and the list lives in memory only.
-->
<UserControl
    x:Class="Veyro.UserControls.NotificationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="CardToolButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="InlineTextButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!--  One card for live and for Earlier notifications. Earlier ones have no tools, reply or actions.  -->
        <DataTemplate x:Key="NotificationCard" x:DataType="viewModels:NotificationItemViewModel">
            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                PointerEntered="Card_PointerEntered"
                PointerExited="Card_PointerExited">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  App icon, or a round placeholder when the phone sent none  -->
                    <Grid
                        Width="40"
                        Height="40"
                        VerticalAlignment="Top">
                        <Image
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind Icon, Mode=OneWay}"
                            Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="20"
                            Visibility="{x:Bind HasNoIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <FontIcon
                                FontSize="18"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE91C;" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="6">

                        <!--  App name on the left; tools and time on the right  -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind AppName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                x:Name="CardTools"
                                Grid.Column="1"
                                Opacity="0"
                                Orientation="Horizontal"
                                Spacing="2">
                                <!--  ADR-063: turn pop-ups for this app off or on  -->
                                <Button
                                    AutomationProperties.Name="More options"
                                    Click="CardMenu_Click"
                                    GotFocus="CardTool_GotFocus"
                                    Style="{StaticResource CardToolButtonStyle}"
                                    ToolTipService.ToolTip="More options"
                                    Visibility="{x:Bind CanSetRules, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="10" Glyph="&#xE712;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Dismiss on phone"
                                    Click="CardDismiss_Click"
                                    GotFocus="CardTool_GotFocus"
                                    Style="{StaticResource CardToolButtonStyle}"
                                    ToolTipService.ToolTip="Dismiss on phone"
                                    Visibility="{x:Bind IsLive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind TimeText, Mode=OneWay}" />
                        </Grid>

                        <TextBlock
                            FontWeight="SemiBold"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasTitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            IsTextSelectionEnabled="True"
                            MaxLines="6"
                            Text="{x:Bind Text, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!--  ADR-063: only the code itself goes onto this PC's clipboard  -->
                        <Button
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Copy code"
                            Click="CopyCode_Click"
                            ToolTipService.ToolTip="Copy the code to this PC's clipboard"
                            Visibility="{x:Bind HasCode, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="{x:Bind CopyCodeGlyph, Mode=OneWay}" />
                                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{x:Bind CopyCodeLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>

                        <!--  Inline reply (Enter sends)  -->
                        <Grid ColumnSpacing="4" Visibility="{x:Bind CanReply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                AutomationProperties.Name="Reply text"
                                KeyDown="ReplyBox_KeyDown"
                                MaxLength="4096"
                                PlaceholderText="Reply"
                                Text="{x:Bind ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Send reply"
                                Click="ReplySend_Click"
                                Style="{StaticResource InlineTextButtonStyle}"
                                ToolTipService.ToolTip="Send">
                                <FontIcon Glyph="&#xE724;" />
                            </Button>
                        </Grid>

                        <!--  The phone's own action buttons  -->
                        <ItemsRepeater ItemsSource="{x:Bind Actions, Mode=OneWay}" Visibility="{x:Bind HasActions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal" Spacing="4" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:NotificationActionItem">
                                    <Button
                                        MaxWidth="140"
                                        Click="CardAction_Click"
                                        Style="{StaticResource InlineTextButtonStyle}">
                                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind NoteText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind HasNote, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title, Clear all, Do not disturb  -->
        <Grid Margin="0,8,0,0" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Notifications"
                TextTrimming="CharacterEllipsis" />

            <!--  Clears the list here and dismisses the notifications on the phone too  -->
            <HyperlinkButton
                Grid.Column="1"
                Padding="8,4"
                VerticalAlignment="Center"
                AutomationProperties.Name="Clear all notifications on the phone"
                Click="ClearAll_Click"
                Content="Clear all"
                Visibility="{x:Bind ViewModel.HasNotifications, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Do not disturb: notifications still arrive here, without pop-ups  -->
            <Button
                x:Name="QuietButton"
                Grid.Column="2"
                Padding="8,4"
                VerticalAlignment="Center"
                AutomationProperties.Name="Do not disturb"
                Background="Transparent"
                BorderThickness="0"
                ToolTipService.ToolTip="Do not disturb">
                <FontIcon x:Name="QuietIcon" FontSize="16" Glyph="&#xEA8F;" />
                <Button.Flyout>
                    <Flyout Opening="QuietFlyout_Opening" Placement="BottomEdgeAlignedRight">
                        <StackPanel Width="300" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Do not disturb" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Phone notifications and messages still arrive here, without pop-ups. Calls and incoming files still show."
                                TextWrapping="Wrap" />
                            <ToggleSwitch
                                x:Name="QuietSwitch"
                                Header="Pause pop-ups now"
                                Toggled="QuietSwitch_Toggled" />
                            <ToggleSwitch
                                x:Name="QuietMirrorSwitch"
                                Header="Also while mirroring a phone"
                                Toggled="QuietMirrorSwitch_Toggled" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!--  The list: live cards, then the Earlier group  -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,-14,0"
            Padding="0,0,14,0">
            <StackPanel Spacing="8">
                <ItemsRepeater
                    ItemTemplate="{StaticResource NotificationCard}"
                    ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                    VerticalCacheLength="6">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!--  Only history, nothing current  -->
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.NoCurrentText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasOnlyHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!--  ADR-063: what left the phone in the last 24 hours, kept in memory only  -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Earlier" />
                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Clear history on this PC"
                            Click="ClearHistory_Click"
                            Content="Clear history" />
                    </Grid>
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.HistoryHelp}"
                        TextWrapping="Wrap" />
                    <ItemsRepeater
                        ItemTemplate="{StaticResource NotificationCard}"
                        ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}"
                        VerticalCacheLength="6">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  Nothing at all to show  -->
        <StackPanel
            Grid.Row="1"
            Margin="16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoNotifications, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEA8F;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
