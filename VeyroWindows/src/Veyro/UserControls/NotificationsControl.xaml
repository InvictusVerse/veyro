<UserControl
    x:Class="Veyro.UserControls.NotificationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            FontSize="14"
            FontWeight="SemiBold"
            Text="Notifications" />
        <Border
            Grid.Row="1"
            Padding="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <ListView
                    ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}"
                    SelectionMode="None"
                    AutomationProperties.Name="Phone notifications">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:NotificationItemViewModel">
                            <StackPanel Padding="0,6" Spacing="4">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xEA8F;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind AppName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind TimeText, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="3"
                                        Width="28"
                                        Height="28"
                                        Padding="0"
                                        AutomationProperties.Name="Dismiss on phone"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="Dismiss_Click"
                                        ToolTipService.ToolTip="Dismiss on phone">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </Grid>
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind HasTitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock
                                    MaxLines="4"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        Height="28"
                                        Padding="10,0"
                                        Click="ReplyToggle_Click"
                                        Content="Reply"
                                        Visibility="{x:Bind CanReply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ItemsControl ItemsSource="{x:Bind Actions, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:NotificationActionItem">
                                                <Button
                                                    Height="28"
                                                    MaxWidth="140"
                                                    Padding="10,0"
                                                    Click="Action_Click">
                                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Grid
                                    ColumnSpacing="4"
                                    Visibility="{x:Bind IsReplyOpen, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        Grid.Column="0"
                                        AutomationProperties.Name="Reply text"
                                        KeyDown="ReplyBox_KeyDown"
                                        MaxLength="4096"
                                        PlaceholderText="Type a reply"
                                        Text="{x:Bind ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Grid.Column="1"
                                        AutomationProperties.Name="Send reply"
                                        Click="SendReply_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Send">
                                        <FontIcon FontSize="12" Glyph="&#xE724;" />
                                    </Button>
                                </Grid>

                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind StatusText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ViewModel.HasNoNotifications, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon
                        FontSize="24"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEA8F;" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No notifications" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
