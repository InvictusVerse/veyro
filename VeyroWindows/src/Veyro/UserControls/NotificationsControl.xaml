<!--
    Adapted from Sefirah (https://github.com/shrimqy/Sefirah), src/Sefirah/UserControls/NotificationsControl.xaml, GPL-3.0.
    Modified for Veyro: items come from NotificationMirrorService (ADR-025); dismiss, reply and
    actions go back to the phone. Pin, filter and open-app are not in Veyro's protocol, so they
    are not offered.
-->
<UserControl
    x:Class="Veyro.UserControls.NotificationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,8,0,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Notifications"
                TextTrimming="CharacterEllipsis" />
            <!--  Phone Link's Clear all: dismisses them on the phone too.  -->
            <HyperlinkButton
                Grid.Column="1"
                Padding="8,4"
                VerticalAlignment="Center"
                AutomationProperties.Name="Clear all notifications on the phone"
                Click="ClearAll_Click"
                Content="Clear all"
                Visibility="{x:Bind ViewModel.HasNotifications, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,8,-14,0"
            Padding="0,0,14,0">
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Notifications, Mode=OneWay}" VerticalCacheLength="6">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:NotificationItemViewModel">
                        <Border
                            Margin="0,0,0,8"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            PointerEntered="Card_PointerEntered"
                            PointerExited="Card_PointerExited">
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Top">
                                    <Image
                                        AutomationProperties.AccessibilityView="Raw"
                                        Source="{x:Bind Icon, Mode=OneWay}"
                                        Visibility="{x:Bind HasIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        CornerRadius="20"
                                        Visibility="{x:Bind HasNoIcon, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <FontIcon FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE91C;" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            FontWeight="Medium"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind AppName, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <!--  Hidden until hover, as in Sefirah; still reachable by keyboard.  -->
                                            <Button
                                                Width="20"
                                                Height="20"
                                                Padding="0"
                                                AutomationProperties.Name="Dismiss on phone"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                Click="Dismiss_Click"
                                                GotFocus="DismissButton_GotFocus"
                                                Opacity="0"
                                                Tag="DismissButton"
                                                ToolTipService.ToolTip="Dismiss on phone">
                                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                                            </Button>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                HorizontalTextAlignment="End"
                                                Text="{x:Bind TimeText, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasTitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        MaxLines="6"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasText, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="8">
                                    <Grid ColumnSpacing="4" Visibility="{x:Bind CanReply, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            Grid.Column="0"
                                            AutomationProperties.Name="Reply text"
                                            KeyDown="ReplyBox_KeyDown"
                                            MaxLength="4096"
                                            PlaceholderText="Reply"
                                            Text="{x:Bind ReplyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            Grid.Column="1"
                                            AutomationProperties.Name="Send reply"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Click="SendReply_Click"
                                            ToolTipService.ToolTip="Send">
                                            <FontIcon Glyph="&#xE724;" />
                                        </Button>
                                    </Grid>
                                    <ItemsRepeater ItemsSource="{x:Bind Actions, Mode=OneWay}" Visibility="{x:Bind HasActions, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="4" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:NotificationActionItem">
                                                <Button
                                                    MaxWidth="140"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    Click="Action_Click">
                                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="16,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasNoNotifications, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon
                FontSize="24"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xEA8F;" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
