<UserControl
    x:Class="Veyro.UserControls.PairingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid ColumnSpacing="16" RowSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!--  QR code, countdown and the typed-code fallback  -->
        <Border
            Grid.Column="0"
            Padding="20"
            VerticalAlignment="Top"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel Width="300" Spacing="12">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Scan with Veyro on your phone" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Open Veyro on your phone and scan this code to pair. Scanning it is your approval, so no extra prompt appears on this PC."
                    TextWrapping="Wrap" />

                <Grid
                    Width="260"
                    Height="260"
                    HorizontalAlignment="Center">
                    <Border
                        Padding="10"
                        Background="White"
                        CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasQr, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image
                            x:Name="QrImage"
                            AutomationProperties.Name="Pairing QR code"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.IsExpired, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE823;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Text="This code has expired."
                            TextAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select New code to show a fresh one."
                            TextAlignment="Center" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.QrUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            FontSize="32"
                            Foreground="{ThemeResource SystemFillColorCautionBrush}"
                            Glyph="&#xE7BA;" />
                        <TextBlock
                            MaxWidth="220"
                            HorizontalAlignment="Center"
                            Text="No QR code without a network address. See Network check, or pair from the phone's nearby list."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Time left for this code"
                        IsActive="True"
                        IsIndeterminate="False"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.ExpiryProgress, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay}" />
                    <Button
                        Grid.Column="2"
                        Click="NewCode_Click"
                        Content="New code"
                        ToolTipService.ToolTip="Replace the code and restart the five minutes" />
                </Grid>

                <MenuFlyoutSeparator />

                <!--  ADR-031: the nearby-list path compares a code instead of typing one  -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8EA;" />
                    <TextBlock
                        MaxWidth="270"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No camera? In Veyro on the phone, tap this PC in the nearby list. Both screens then show the same code: check it and click Accept here. Nothing to type."
                        TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="This PC" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.PcName, Mode=OneWay}" />
                    <TextBlock
                        FontFamily="Consolas"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind ViewModel.PcFingerprint, Mode=OneWay}"
                        ToolTipService.ToolTip="Fingerprint. After pairing, the phone shows the same one for this PC." />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Spacing="16">
            <!--  Nearby phones  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Nearby phones" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Phones with Veyro open on this network. A name here is only a hint; pairing proves who is who."
                        TextWrapping="Wrap" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.NearbyPhones, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:NearbyPhoneUiModel">
                                <Grid
                                    Padding="10,8"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    ColumnSpacing="12"
                                    CornerRadius="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE8EA;" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Detail}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="8,2"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind IsPaired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="Already paired" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ViewModel.HasNoNearbyPhones, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="True" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Looking for phones. Open Veyro on your phone."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Network check: names the problem instead of failing silently  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Network check" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsCheckingNetwork, Mode=OneWay}" />
                            <Button
                                AutomationProperties.Name="Check the network again"
                                Click="CheckAgain_Click"
                                ToolTipService.ToolTip="Check again">
                                <FontIcon FontSize="14" Glyph="&#xE72C;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.NetworkChecks, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:NetworkCheckUiModel">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="OK"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;"
                                        Visibility="{x:Bind IsOk, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        Margin="0,2,0,0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Problem"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;"
                                        Visibility="{x:Bind IsProblem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Title}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Detail}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Click="CheckAction_Click"
                                        Content="{x:Bind ActionText}"
                                        Tag="{x:Bind}"
                                        Visibility="{x:Bind HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
