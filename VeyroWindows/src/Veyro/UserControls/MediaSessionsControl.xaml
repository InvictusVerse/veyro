<!--
    Adapted from Sefirah (https://github.com/shrimqy/Sefirah), src/Sefirah/UserControls/MediaSessionsControl.xaml, GPL-3.0.
    Modified for Veyro: one phone session from PhoneMediaViewModel (ADR-026) instead of a FlipView.
    The card is only shown while the phone reports a session; nothing here is a placeholder.
-->
<UserControl
    x:Class="Veyro.UserControls.MediaSessionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="4" Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="94"
                Height="94"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <Grid>
                    <FontIcon
                        FontSize="28"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xEC4F;"
                        Visibility="{x:Bind ViewModel.HasNoArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Image
                        AutomationProperties.Name="Album art"
                        Source="{x:Bind ViewModel.Art, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.HasArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.HasAppName, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    FontSize="14"
                    FontWeight="Medium"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind ViewModel.HasTitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    Visibility="{x:Bind ViewModel.HasArtist, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button
                        AutomationProperties.Name="Previous track"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Previous_Click"
                        IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}"
                        ToolTipService.ToolTip="Previous">
                        <FontIcon FontSize="14" Glyph="&#xE892;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="PlayPause_Click"
                        IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Next track"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Next_Click"
                        IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}"
                        ToolTipService.ToolTip="Next">
                        <FontIcon FontSize="14" Glyph="&#xE893;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Phone media volume"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="Volume_Click"
                        ToolTipService.ToolTip="Volume"
                        Visibility="{x:Bind ViewModel.HasVolume, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.ShowVolume, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
            <Slider
                x:Name="VolumeSlider"
                Grid.Column="1"
                AutomationProperties.Name="Phone volume"
                IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                IsThumbToolTipEnabled="False"
                Maximum="100"
                Minimum="0"
                StepFrequency="1"
                Value="{x:Bind ViewModel.Volume, Mode=OneWay}"
                ValueChanged="VolumeSlider_ValueChanged" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.VolumeText, Mode=OneWay}" />
        </Grid>

        <Grid
            Grid.Row="2"
            ColumnSpacing="8"
            Visibility="{x:Bind ViewModel.CanSeek, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
            <Slider
                x:Name="SeekSlider"
                Grid.Column="1"
                AutomationProperties.Name="Playback position"
                IsEnabled="{x:Bind ViewModel.CanSeekNow, Mode=OneWay}"
                IsThumbToolTipEnabled="False"
                Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                Minimum="0"
                StepFrequency="1"
                Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                ValueChanged="SeekSlider_ValueChanged" />
            <TextBlock
                Grid.Column="2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
