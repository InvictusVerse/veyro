<UserControl
    x:Class="Veyro.UserControls.MediaSessionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- No session -->
        <Grid
            ColumnSpacing="12"
            Visibility="{x:Bind ViewModel.HasNoSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.Column="0"
                Width="40"
                Height="40"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="6">
                <FontIcon FontSize="16" Glyph="&#xEC4F;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="No active media session" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Media playback from your phone appears here" />
            </StackPanel>
        </Grid>

        <!-- Phone media session -->
        <StackPanel
            Spacing="8"
            Visibility="{x:Bind ViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            FontSize="16"
                            Glyph="&#xEC4F;"
                            Visibility="{x:Bind ViewModel.HasNoArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Image
                            AutomationProperties.Name="Album art"
                            Source="{x:Bind ViewModel.Art, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ViewModel.HasArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasArtist, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasAppName, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <Grid
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.CanSeek, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                <Slider
                    x:Name="SeekSlider"
                    Grid.Column="1"
                    AutomationProperties.Name="Playback position"
                    IsEnabled="{x:Bind ViewModel.CanSeekNow, Mode=OneWay}"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind ViewModel.DurationSeconds, Mode=OneWay}"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.PositionSeconds, Mode=OneWay}"
                    ValueChanged="SeekSlider_ValueChanged" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
            </Grid>

            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Previous"
                    Click="Previous_Click"
                    IsEnabled="{x:Bind ViewModel.CanPrev, Mode=OneWay}"
                    ToolTipService.ToolTip="Previous">
                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                </Button>
                <Button
                    Width="40"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}"
                    Click="PlayPause_Click"
                    IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PlayPauseLabel, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="Next"
                    Click="Next_Click"
                    IsEnabled="{x:Bind ViewModel.CanNext, Mode=OneWay}"
                    ToolTipService.ToolTip="Next">
                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                </Button>
            </StackPanel>

            <Grid
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.HasVolume, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Grid.Column="0"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}" />
                <Slider
                    x:Name="VolumeSlider"
                    Grid.Column="1"
                    AutomationProperties.Name="Phone volume"
                    IsEnabled="{x:Bind ViewModel.CanControl, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=OneWay}"
                    ValueChanged="VolumeSlider_ValueChanged" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
