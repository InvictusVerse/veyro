<UserControl
    x:Class="Veyro.UserControls.CallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caller and status -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="44"
                Height="44"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="22">
                <FontIcon
                    FontSize="18"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE717;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.Call.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Call.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.Call.HasSubtitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Call.StatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- In-call controls -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="{x:Bind ViewModel.Call.IsNotIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ToggleButton
                AutomationProperties.Name="{x:Bind ViewModel.Call.MuteText, Mode=OneWay}"
                Click="Mute_Click"
                IsChecked="{x:Bind ViewModel.Call.IsMuted, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.Call.CanMute, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Call.MuteText, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE720;" />
            </ToggleButton>
            <ToggleButton
                AutomationProperties.Name="{x:Bind ViewModel.Call.HoldText, Mode=OneWay}"
                Click="Hold_Click"
                IsChecked="{x:Bind ViewModel.Call.IsHeld, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.Call.CanHold, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Call.HoldText, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE769;" />
            </ToggleButton>
            <Button
                AutomationProperties.Name="{x:Bind ViewModel.Call.AudioSwitchText, Mode=OneWay}"
                Click="Audio_Click"
                IsEnabled="{x:Bind ViewModel.Call.CanSwitchAudio, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind ViewModel.Call.AudioSwitchText, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="14" Glyph="&#xE7F5;" />
                    <TextBlock Text="{x:Bind ViewModel.Call.AudioRouteText, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Answer / decline / end -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Click="Answer_Click"
                Content="Answer on PC"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.Call.IsIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Click="Decline_Click"
                Content="Decline"
                Visibility="{x:Bind ViewModel.Call.IsIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                AutomationProperties.Name="End call"
                Click="End_Click"
                Foreground="White"
                Visibility="{x:Bind ViewModel.Call.IsNotIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#AF2619" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8F1E13" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE778;" />
                    <TextBlock Text="End" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            Grid.Row="3"
            FontSize="12"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.Call.ErrorText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Call.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
