<?xml version="1.0" encoding="utf-8"?>
<!--
    Content of the in-call window (CallWindow, ADR-029). The call comes from CallWindowViewModel.Call.
    A ringing call offers Answer on PC and Decline. Any other call offers mute, hold, audio route and End.
-->
<UserControl
    x:Class="Veyro.UserControls.CallView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Padding="20,18,20,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Who is calling and how far the call is  -->
        <Grid Grid.Row="0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="48"
                Height="48"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="24">
                <FontIcon
                    FontSize="20"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE717;" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    FontSize="18"
                    Text="{x:Bind ViewModel.Call.Title, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Call.Subtitle, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{x:Bind ViewModel.Call.HasSubtitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Call.StatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  Actions: call controls on the left, answer / decline / end on the right  -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.Call.IsNotIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton
                    Width="40"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.Call.MuteText, Mode=OneWay}"
                    Click="Mute_Click"
                    IsChecked="{x:Bind ViewModel.Call.IsMuted, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Call.CanMute, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Call.MuteText, Mode=OneWay}">
                    <FontIcon FontSize="15" Glyph="&#xE720;" />
                </ToggleButton>
                <ToggleButton
                    Width="40"
                    Height="36"
                    Padding="0"
                    AutomationProperties.Name="{x:Bind ViewModel.Call.HoldText, Mode=OneWay}"
                    Click="Hold_Click"
                    IsChecked="{x:Bind ViewModel.Call.IsHeld, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.Call.CanHold, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Call.HoldText, Mode=OneWay}">
                    <FontIcon FontSize="15" Glyph="&#xE769;" />
                </ToggleButton>
                <Button
                    Height="36"
                    AutomationProperties.Name="{x:Bind ViewModel.Call.AudioSwitchText, Mode=OneWay}"
                    Click="Audio_Click"
                    IsEnabled="{x:Bind ViewModel.Call.CanSwitchAudio, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Call.AudioSwitchText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE7F5;" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Call.AudioRouteText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button
                    Height="36"
                    Click="Answer_Click"
                    Content="Answer on PC"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.Call.IsIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    Height="36"
                    Click="Decline_Click"
                    Content="Decline"
                    Visibility="{x:Bind ViewModel.Call.IsIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    Height="36"
                    AutomationProperties.Name="End call"
                    Click="End_Click"
                    Foreground="White"
                    Visibility="{x:Bind ViewModel.Call.IsNotIncoming, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#B02417" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8F1E13" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="15" Glyph="&#xE778;" />
                        <TextBlock VerticalAlignment="Center" Text="End" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!--  Shown when Windows or the phone refused an action  -->
        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Call.ErrorText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.Call.HasError, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</UserControl>
