<UserControl
    x:Class="Veyro.UserControls.DeviceControlCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Core.Models">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device preview frame -->
            <Grid
                x:Name="PhoneFrameGrid"
                Grid.Column="0"
                Width="54"
                Height="100"
                VerticalAlignment="Center"
                CornerRadius="8">
                <Border
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FF0070FF" />
                            <GradientStop Offset="1" Color="#FF2E90FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Glyph="&#xE8EA;" />
                </Border>
            </Grid>

            <!-- Device Info, Battery, Audio, and Quick Actions -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                <ComboBox
                    x:Name="DeviceSelectorCombo"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Device, Mode=TwoWay}" />

                <!-- Phone-reported status (ADR-026) -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        AutomationProperties.Name="{x:Bind StatusViewModel.RingerLabel, Mode=OneWay}"
                        FontSize="14"
                        Glyph="{x:Bind StatusViewModel.RingerGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.RingerLabel, Mode=OneWay}" />
                    <FontIcon
                        AutomationProperties.Name="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                        FontSize="14"
                        Glyph="&#xE708;"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <FontIcon
                        AutomationProperties.Name="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                        FontSize="14"
                        Glyph="{x:Bind StatusViewModel.BatteryGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind StatusViewModel.BatteryText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="DeviceActionsButton"
                        Height="32"
                        MinWidth="32"
                        Padding="6,0"
                        ToolTipService.ToolTip="Device Actions">
                        <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="240" Spacing="4">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SendFilesButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE72D;" />
                                            <TextBlock Text="Send Files" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SendClipboardButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF0E3;" />
                                            <TextBlock Text="Send Clipboard" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OpenDownloadsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xEC50;" />
                                            <TextBlock Text="Open Received Folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        Height="32"
                        Padding="12,0"
                        Click="RefreshConnection_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Device.ConnectionStatusText, Mode=OneWay, FallbackValue='Disconnected'}" />
                            <FontIcon FontSize="12" Glyph="&#xE895;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Phone controls (devControl). Selections show only what the phone reports back. -->
        <StackPanel Grid.Row="1" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Height="32"
                    Padding="10,0"
                    Click="Ring_Click"
                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                    ToolTipService.ToolTip="Ring the phone at full volume for up to 30 seconds">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                        <TextBlock Text="{x:Bind StatusViewModel.RingButtonText, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <ComboBox
                    x:Name="RingerCombo"
                    Width="112"
                    Height="32"
                    AutomationProperties.Name="Phone ringer mode"
                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                    PlaceholderText="Ringer"
                    SelectedIndex="{x:Bind StatusViewModel.RingerIndex, Mode=OneWay}"
                    SelectionChanged="RingerCombo_SelectionChanged">
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Vibrate" />
                    <ComboBoxItem Content="Silent" />
                </ComboBox>
                <ToggleButton
                    x:Name="DndToggle"
                    Width="36"
                    Height="32"
                    Padding="0"
                    AutomationProperties.Name="Do not disturb"
                    Click="Dnd_Click"
                    IsChecked="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay}"
                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE708;" />
                </ToggleButton>
            </StackPanel>
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind StatusViewModel.StatusText, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind StatusViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
