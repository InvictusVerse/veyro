<UserControl
    x:Class="Veyro.UserControls.DeviceControlCenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Veyro.Core.Models">

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Device preview frame -->
            <Grid
                x:Name="PhoneFrameGrid"
                Grid.Column="0"
                Width="54"
                Height="100"
                VerticalAlignment="Center"
                CornerRadius="8">
                <Border
                    CornerRadius="8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#FF0070FF" />
                            <GradientStop Offset="1" Color="#FF2E90FF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="20"
                        Foreground="White"
                        Glyph="&#xE8EA;" />
                </Border>
            </Grid>

            <!-- Device Info, Battery, Audio, and Quick Actions -->
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                <ComboBox
                    x:Name="DeviceSelectorCombo"
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Device, Mode=TwoWay}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                    <FontIcon FontSize="14" Glyph="&#xE83F;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.Device.BatteryText, Mode=OneWay, FallbackValue='--%'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="DeviceActionsButton"
                        Height="32"
                        MinWidth="32"
                        Padding="6,0"
                        ToolTipService.ToolTip="Device Actions">
                        <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Width="240" Spacing="4">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SendFilesButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE72D;" />
                                            <TextBlock Text="Send Files" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="SendClipboardButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF0E3;" />
                                            <TextBlock Text="Send Clipboard" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="OpenDownloadsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xEC50;" />
                                            <TextBlock Text="Open Received Folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button
                        Height="32"
                        Padding="12,0"
                        Click="RefreshConnection_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.Device.ConnectionStatusText, Mode=OneWay, FallbackValue='Disconnected'}" />
                            <FontIcon FontSize="12" Glyph="&#xE895;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
