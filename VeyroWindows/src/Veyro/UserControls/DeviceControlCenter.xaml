<!--
    The phone panel at the top of the main window's sidebar (ADR-026, ADR-038, ADR-060).

    Top block: the phone drawn with its own wallpaper (tap = mirror window, wheel = switch phone),
    its name, a status line, the connection pill and three small actions.
    Below it: a grid of quick-control tiles (do not disturb, sound, media, find phone,
    flashlight, volume, brightness).

    Everything shown comes from the phone or the session registry. With no phone connected the
    status line is empty; no battery, signal, ringer or DND value is ever invented. A tile that
    toggles something on the phone shows the phone's reported state and only asks for a change.
-->
<UserControl
    x:Class="Veyro.UserControls.DeviceControlCenter"
    x:Name="PanelRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Phone name as a picker when several phones are paired  -->
        <Style x:Key="PhonePickerStyle" BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4,0,4" />
        </Style>

        <!--  Round 32 px buttons beside the connection pill and in the media transport  -->
        <Style x:Key="RoundActionStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <!--  Quick-control tiles: an icon over a short caption  -->
        <Style x:Key="TileButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TileToggleStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="60" />
            <Setter Property="Padding" Value="4,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="TileCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Hint over the phone while the pointer is on it: a click opens the mirror window (ADR-066)  -->
        <Storyboard x:Name="MirrorHintShow">
            <DoubleAnimation
                Storyboard.TargetName="MirrorHint"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.2" />
        </Storyboard>
        <Storyboard x:Name="MirrorHintHide">
            <DoubleAnimation
                Storyboard.TargetName="MirrorHint"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.2" />
        </Storyboard>
    </UserControl.Resources>

    <StackPanel Spacing="14">

        <!--  ===== Identity block ===== -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  The phone with its own wallpaper. Wheel: next/previous paired phone. Tap: mirror window.  -->
            <Grid
                x:Name="PhoneScreen"
                Width="76"
                Height="152"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                PointerEntered="PhoneScreen_PointerEntered"
                PointerExited="PhoneScreen_PointerExited"
                PointerWheelChanged="PhoneScreen_PointerWheelChanged"
                Tapped="PhoneScreen_Tapped">
                <Border
                    Background="#FF1B1B1F"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14" />
                <Grid Margin="4" Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}">
                    <!--  Shown until (and unless) the phone sends a wallpaper  -->
                    <Border CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#FF2F5BEA" />
                                <GradientStop Offset="0.55" Color="#FF4C8DF6" />
                                <GradientStop Offset="1" Color="#FF7FC4FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="10" Visibility="{x:Bind StatusViewModel.HasWallpaper, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{x:Bind StatusViewModel.Wallpaper, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Ellipse
                        Width="5"
                        Height="5"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Fill="#FF0B0B0E" />
                </Grid>
                <Grid
                    x:Name="MirrorHint"
                    Margin="4"
                    Background="#99000000"
                    CornerRadius="10"
                    Opacity="0"
                    ToolTipService.ToolTip="{x:Bind ScreenMirrorText}"
                    Visibility="Collapsed">
                    <FontIcon
                        FontSize="20"
                        Foreground="White"
                        Glyph="&#xEC15;"
                        Opacity="0.7" />
                </Grid>
            </Grid>

            <!--  Shown once, the first time a second phone is paired. Kept inside the identity grid
                  so it adds no gap to the stack.  -->
            <TeachingTip
                x:Name="SwitchPhoneTip"
                IsLightDismissEnabled="True"
                PreferredPlacement="Right"
                Subtitle="Scroll over the phone to switch between paired phones."
                Target="{x:Bind PhoneScreen}"
                Title="Switch phones" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">

                <!--  Name: plain text for one phone, a picker for several (ADR-040 shows live state per phone)  -->
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasSingleDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox
                    MaxWidth="240"
                    Margin="-8,0,0,0"
                    AutomationProperties.Name="Phone shown in Veyro"
                    ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.Device, Mode=TwoWay}"
                    Style="{StaticResource PhonePickerStyle}"
                    Visibility="{x:Bind ViewModel.HasMultipleDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:PairedDeviceUiModel">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                    Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind ShowsConnecting, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ConnectionStatusText, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!--  Status line (ADR-026, ADR-038): a glyph appears only once the phone reported it  -->
                <StackPanel
                    MinHeight="20"
                    Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}"
                    Orientation="Horizontal"
                    Spacing="10">
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StatusViewModel.BluetoothLabel, Mode=OneWay}"
                        FontSize="16"
                        Glyph="&#xE702;"
                        Opacity="{x:Bind StatusViewModel.BluetoothOpacity, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.BluetoothLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.HasBluetooth, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StatusViewModel.WifiLabel, Mode=OneWay}"
                        FontSize="16"
                        Glyph="{x:Bind StatusViewModel.WifiGlyph, Mode=OneWay}"
                        Opacity="{x:Bind StatusViewModel.WifiOpacity, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.WifiLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.HasWifi, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StatusViewModel.CellLabel, Mode=OneWay}"
                        FontSize="16"
                        Glyph="{x:Bind StatusViewModel.CellGlyph, Mode=OneWay}"
                        Opacity="{x:Bind StatusViewModel.CellOpacity, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.CellLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.HasCell, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                        FontSize="16"
                        Glyph="&#xE708;"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTipService.ToolTip="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                        Visibility="{x:Bind StatusViewModel.HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="{x:Bind StatusViewModel.BatteryText, Mode=OneWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                            FontSize="16"
                            Glyph="{x:Bind StatusViewModel.BatteryGlyph, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Waiting for phone status"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind StatusViewModel.IsWaitingForStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!--  Connection pill, then reconnect / send files / more  -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button
                        Height="32"
                        Padding="12,0"
                        AutomationProperties.Name="{x:Bind ViewModel.ConnectionPillText, Mode=OneWay}"
                        CornerRadius="16"
                        ToolTipService.ToolTip="Connection details">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Grid Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Fill="{ThemeResource SystemFillColorNeutralBrush}" Visibility="{x:Bind ViewModel.IsOffline, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.ConnectionPillText, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Opened="SidebarFlyout_Opened" ShouldConstrainToRootBounds="False">
                                <StackPanel MaxWidth="340" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ConnectionHelpText, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Fingerprint" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  The phone opens the link; this announces the PC again so the phone reconnects  -->
                    <Button
                        AutomationProperties.Name="Reconnect"
                        Click="Reconnect_Click"
                        Style="{StaticResource RoundActionStyle}"
                        ToolTipService.ToolTip="Reconnect">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>

                    <!--  ADR-038: straight to the file picker  -->
                    <Button
                        AutomationProperties.Name="Send files"
                        Click="SendFiles_Click"
                        Style="{StaticResource RoundActionStyle}"
                        ToolTipService.ToolTip="Send files">
                        <FontIcon FontSize="14" Glyph="&#xE898;" />
                    </Button>

                    <Button
                        AutomationProperties.Name="More"
                        Style="{StaticResource RoundActionStyle}"
                        ToolTipService.ToolTip="More">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <!--  ADR-073: the entries reflect what the shown phone can do right now  -->
                            <MenuFlyout Opening="MoreMenu_Opening" Placement="Bottom">
                                <MenuFlyoutItem x:Name="SpeakerItem" Click="Speaker_Click" Text="Play PC sound on phone">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7F5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="PhotoItem" Click="TakePhoto_Click" Text="Take photo with phone (Ctrl+Alt+C)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE722;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="ScanItem" Click="ScanDocument_Click" Text="Scan document with phone (Ctrl+Alt+D)">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8A5;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <!--  ADR-067: the webcam entry lives here so the button row fits the sidebar  -->
                                <MenuFlyoutItem
                                    Click="Webcam_Click"
                                    IsEnabled="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay}"
                                    Text="Use phone as webcam">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE960;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="SendFiles_Click" Text="Send files">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE898;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <!--  ADR-064: a whole folder with its structure  -->
                                <MenuFlyoutItem Click="SendFolder_Click" Text="Send folder">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8B7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OpenReceived_Click" Text="Open received files">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEC50;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="DeviceSettings_Click" Text="Device settings">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE713;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  ===== Quick controls =====
              A toggle tile shows the phone's reported state; clicking only sends a request.  -->
        <Grid ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Do not disturb  -->
            <ToggleButton
                x:Name="DndTile"
                Grid.Row="0"
                Grid.Column="0"
                AutomationProperties.Name="{x:Bind StatusViewModel.DndButtonLabel, Mode=OneWay}"
                Click="DndTile_Click"
                IsChecked="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay}"
                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                Style="{StaticResource TileToggleStyle}"
                ToolTipService.ToolTip="{x:Bind StatusViewModel.DndButtonLabel, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon FontSize="20" Glyph="&#xE708;" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="DND" />
                </StackPanel>
            </ToggleButton>

            <!--  Sound mode: the tile shows the reported mode, the flyout picks one  -->
            <Button
                Grid.Row="0"
                Grid.Column="1"
                AutomationProperties.Name="{x:Bind StatusViewModel.SoundLabel, Mode=OneWay}"
                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                Style="{StaticResource TileButtonStyle}"
                ToolTipService.ToolTip="{x:Bind StatusViewModel.SoundLabel, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon FontSize="20" Glyph="{x:Bind StatusViewModel.SoundGlyph, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Sound" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Opened="SidebarFlyout_Opened" ShouldConstrainToRootBounds="False">
                        <StackPanel Width="300" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sound" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleButton
                                    Grid.Column="0"
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Silent"
                                    Click="RingerMode_Click"
                                    IsChecked="{x:Bind StatusViewModel.IsRingerSilent, Mode=OneWay}"
                                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                    Tag="0">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE7ED;" />
                                        <TextBlock FontSize="12" Text="Silent" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    Grid.Column="1"
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Vibrate"
                                    Click="RingerMode_Click"
                                    IsChecked="{x:Bind StatusViewModel.IsRingerVibrate, Mode=OneWay}"
                                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                    Tag="1">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xE877;" />
                                        <TextBlock FontSize="12" Text="Vibrate" />
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton
                                    Grid.Column="2"
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Ring"
                                    Click="RingerMode_Click"
                                    IsChecked="{x:Bind StatusViewModel.IsRingerNormal, Mode=OneWay}"
                                    IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                    Tag="2">
                                    <StackPanel Spacing="4">
                                        <FontIcon Glyph="&#xEA8F;" />
                                        <TextBlock FontSize="12" Text="Ring" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Media volume is under Media while something plays."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Media on the phone: title, artist, transport  -->
            <Button
                Grid.Row="0"
                Grid.Column="2"
                AutomationProperties.Name="Media"
                Style="{StaticResource TileButtonStyle}"
                ToolTipService.ToolTip="Media">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon FontSize="20" Glyph="&#xE8D6;" />
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Media" />
                </StackPanel>
                <Button.Flyout>
                    <Flyout Opened="SidebarFlyout_Opened" ShouldConstrainToRootBounds="False">
                        <StackPanel Width="280" Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Media" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind NoMediaMessage(ViewModel.IsDeviceConnected), Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind MediaViewModel.HasNoSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid ColumnSpacing="12" Visibility="{x:Bind MediaViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="56"
                                    Height="56"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <Grid>
                                        <FontIcon
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xEC4F;"
                                            Visibility="{x:Bind MediaViewModel.HasNoArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Image
                                            AutomationProperties.Name="Album art"
                                            Source="{x:Bind MediaViewModel.Art, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind MediaViewModel.HasArt, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind MediaViewModel.Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind MediaViewModel.Artist, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind MediaViewModel.AppName, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8"
                                Visibility="{x:Bind MediaViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button
                                    AutomationProperties.Name="Previous track"
                                    Click="MediaPrevious_Click"
                                    IsEnabled="{x:Bind MediaViewModel.CanPrev, Mode=OneWay}"
                                    Style="{StaticResource RoundActionStyle}"
                                    ToolTipService.ToolTip="Previous">
                                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                                </Button>
                                <Button
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    AutomationProperties.Name="{x:Bind MediaViewModel.PlayPauseLabel, Mode=OneWay}"
                                    Click="MediaPlayPause_Click"
                                    CornerRadius="20"
                                    IsEnabled="{x:Bind MediaViewModel.CanControl, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind MediaViewModel.PlayPauseLabel, Mode=OneWay}">
                                    <FontIcon FontSize="16" Glyph="{x:Bind MediaViewModel.PlayPauseGlyph, Mode=OneWay}" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Next track"
                                    Click="MediaNext_Click"
                                    IsEnabled="{x:Bind MediaViewModel.CanNext, Mode=OneWay}"
                                    Style="{StaticResource RoundActionStyle}"
                                    ToolTipService.ToolTip="Next">
                                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--  Find my phone: rings it at full volume, up to 30 s  -->
            <ToggleButton
                x:Name="FindTile"
                Grid.Row="0"
                Grid.Column="3"
                AutomationProperties.Name="{x:Bind StatusViewModel.RingButtonText, Mode=OneWay}"
                Click="FindTile_Click"
                IsChecked="{x:Bind StatusViewModel.IsRinging, Mode=OneWay}"
                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                Style="{StaticResource TileToggleStyle}"
                ToolTipService.ToolTip="Find my phone: ring it at full volume for up to 30 seconds">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <Grid Height="20">
                        <FontIcon Margin="-6,0,0,0" FontSize="20" Glyph="&#xE8EA;" />
                        <FontIcon Margin="8,0,-8,0" FontSize="12" Glyph="&#xEBC5;" />
                    </Grid>
                    <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Find" />
                </StackPanel>
            </ToggleButton>

            <!--  ADR-060: flashlight, media volume, brightness. Each tile sits in a hit-testable
                  Grid so its tooltip can still say why it is unavailable while the tile is disabled.  -->
            <Grid
                Grid.Row="1"
                Grid.Column="0"
                Background="Transparent"
                ToolTipService.ToolTip="{x:Bind StatusViewModel.TorchTip, Mode=OneWay}">
                <ToggleButton
                    x:Name="TorchTile"
                    AutomationProperties.Name="{x:Bind StatusViewModel.TorchTip, Mode=OneWay}"
                    Click="TorchTile_Click"
                    IsChecked="{x:Bind StatusViewModel.IsTorchOn, Mode=OneWay}"
                    IsEnabled="{x:Bind StatusViewModel.CanTorch, Mode=OneWay}"
                    Style="{StaticResource TileToggleStyle}">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <FontIcon FontSize="20" Glyph="&#xEA80;" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Torch" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <Grid
                Grid.Row="1"
                Grid.Column="1"
                Background="Transparent"
                ToolTipService.ToolTip="{x:Bind StatusViewModel.VolumeTip, Mode=OneWay}">
                <Button
                    AutomationProperties.Name="{x:Bind StatusViewModel.VolumeTip, Mode=OneWay}"
                    IsEnabled="{x:Bind StatusViewModel.CanVolume, Mode=OneWay}"
                    Style="{StaticResource TileButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <FontIcon FontSize="20" Glyph="&#xE995;" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Volume" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Opened="SidebarFlyout_Opened" ShouldConstrainToRootBounds="False">
                            <StackPanel Width="280" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Media volume on the phone" />
                                <Slider
                                    AutomationProperties.Name="Phone media volume"
                                    IsEnabled="{x:Bind StatusViewModel.CanVolume, Mode=OneWay}"
                                    Maximum="100"
                                    Minimum="0"
                                    StepFrequency="1"
                                    Value="{x:Bind StatusViewModel.ShownMediaVolume, Mode=OneWay}"
                                    ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <Grid
                Grid.Row="1"
                Grid.Column="2"
                Background="Transparent"
                ToolTipService.ToolTip="{x:Bind StatusViewModel.BrightnessTip, Mode=OneWay}">
                <Button
                    AutomationProperties.Name="{x:Bind StatusViewModel.BrightnessTip, Mode=OneWay}"
                    IsEnabled="{x:Bind StatusViewModel.CanBrightness, Mode=OneWay}"
                    Style="{StaticResource TileButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <FontIcon FontSize="20" Glyph="&#xE706;" />
                        <TextBlock Style="{StaticResource TileCaptionStyle}" Text="Brightness" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Opened="SidebarFlyout_Opened" ShouldConstrainToRootBounds="False">
                            <!--  Fixed width so the note wraps instead of widening the flyout  -->
                            <StackPanel Width="280" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Screen brightness on the phone" />
                                <Slider
                                    AutomationProperties.Name="Phone screen brightness"
                                    IsEnabled="{x:Bind StatusViewModel.CanBrightness, Mode=OneWay}"
                                    Maximum="100"
                                    Minimum="0"
                                    StepFrequency="1"
                                    Value="{x:Bind StatusViewModel.ShownBrightness, Mode=OneWay}"
                                    ValueChanged="BrightnessSlider_ValueChanged" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Automatic brightness on the phone"
                                    Header="Automatic brightness"
                                    IsEnabled="{x:Bind StatusViewModel.CanBrightness, Mode=OneWay}"
                                    IsOn="{x:Bind StatusViewModel.IsAutoBrightness, Mode=OneWay}"
                                    Toggled="AutoBrightness_Toggled" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Moving the slider turns automatic brightness off, as on the phone."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Grid>

        <!--  Last request that failed  -->
        <TextBlock
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind StatusViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind StatusViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

    </StackPanel>
</UserControl>
