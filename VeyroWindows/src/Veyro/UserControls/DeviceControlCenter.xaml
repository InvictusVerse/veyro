<!--
    Adapted from Sefirah (https://github.com/shrimqy/Sefirah), src/Sefirah/UserControls/DeviceControlCenter.xaml, GPL-3.0.
    Modified for Veyro.
    Every value shown here is reported by the phone or the session registry. With no phone
    connected the status row is empty: no battery, ringer or DND state is invented.
-->
<UserControl
    x:Class="Veyro.UserControls.DeviceControlCenter"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />

        <Style x:Key="ConnectionSplitButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        </Style>

        <Style x:Key="DeviceNameComboBoxStyle" BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FlyoutRowButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="PhoneFrameOverlay"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.200" />
        </Storyboard>
        <Storyboard x:Name="FadeOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="PhoneFrameOverlay"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.200" />
        </Storyboard>
    </UserControl.Resources>

    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Phone frame. Mouse wheel switches between paired phones (as in Sefirah).  -->
        <Grid
            x:Name="PhoneFrameGrid"
            Grid.Column="0"
            Width="54"
            Height="100"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
            CornerRadius="8"
            PointerEntered="PhoneFrame_PointerEntered"
            PointerExited="PhoneFrame_PointerExited"
            PointerWheelChanged="PhoneFrame_PointerWheelChanged">
            <Rectangle
                Opacity="0.5"
                RadiusX="4"
                RadiusY="4"
                Stroke="Black"
                StrokeThickness="2">
                <Rectangle.Fill>
                    <SolidColorBrush Opacity="0.1" Color="{ThemeResource SystemBaseLowColor}" />
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle
                Margin="2"
                RadiusX="4"
                RadiusY="4"
                Stroke="Black"
                StrokeThickness="1" />
            <Border Margin="3" CornerRadius="4" Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FF0070FF" />
                        <GradientStop Offset="1" Color="#FF2E90FF" />
                    </LinearGradientBrush>
                </Border.Background>
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="White"
                    Glyph="&#xE8EA;" />
            </Border>
            <!--  Sefirah starts scrcpy here. Veyro has no screen mirroring yet, and says so.  -->
            <Grid
                x:Name="PhoneFrameOverlay"
                Background="#80000000"
                Opacity="0"
                ToolTipService.ToolTip="{x:Bind ScreenMirrorText}"
                Visibility="Collapsed">
                <FontIcon Foreground="White" Glyph="&#xEC15;" Opacity="0.6" />
            </Grid>
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind ViewModel.HasSingleDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ComboBox
                Margin="-8,0,0,0"
                AutomationProperties.Name="Phone shown in Veyro"
                ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.Device, Mode=TwoWay}"
                Style="{StaticResource DeviceNameComboBoxStyle}"
                Visibility="{x:Bind ViewModel.HasMultipleDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PairedDeviceUiModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  Phone-reported status (ADR-026). Each icon exists only once the phone reported it.  -->
            <StackPanel
                MinHeight="32"
                Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="AudioButton"
                    Padding="4"
                    AutomationProperties.Name="{x:Bind StatusViewModel.RingerLabel, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind StatusViewModel.RingerLabel, Mode=OneWay}"
                    Visibility="{x:Bind StatusViewModel.HasRinger, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon Glyph="{x:Bind StatusViewModel.RingerGlyph, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout x:Name="AudioFlyout" Opened="PaneFlyout_Opened" ShouldConstrainToRootBounds="False">
                            <StackPanel MinWidth="260" Spacing="8">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ringer" />
                                <!--  Selections show only what the phone reports; a click is a request.  -->
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Silent"
                                        Click="RingerSilent_Click"
                                        IsChecked="{x:Bind StatusViewModel.IsRingerSilent, Mode=OneWay}"
                                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE7ED;" />
                                            <TextBlock FontSize="12" Text="Silent" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Vibrate"
                                        Click="RingerVibrate_Click"
                                        IsChecked="{x:Bind StatusViewModel.IsRingerVibrate, Mode=OneWay}"
                                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xE877;" />
                                            <TextBlock FontSize="12" Text="Vibrate" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <ToggleButton
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Ring"
                                        Click="RingerNormal_Click"
                                        IsChecked="{x:Bind StatusViewModel.IsRingerNormal, Mode=OneWay}"
                                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}">
                                        <StackPanel Spacing="4">
                                            <FontIcon Glyph="&#xEA8F;" />
                                            <TextBlock FontSize="12" Text="Ring" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Media volume is in the media card below while something plays."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <FontIcon
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                    FontSize="14"
                    Glyph="&#xE708;"
                    ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                    Visibility="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4"
                    ToolTipService.ToolTip="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                    Visibility="{x:Bind StatusViewModel.HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <FontIcon AutomationProperties.Name="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}" Glyph="{x:Bind StatusViewModel.BatteryGlyph, Mode=OneWay}" />
                    <TextBlock FontWeight="SemiBold" Text="{x:Bind StatusViewModel.BatteryText, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Waiting for phone status"
                    Visibility="{x:Bind StatusViewModel.IsWaitingForStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="DeviceActionsButton"
                    Height="32"
                    MinWidth="32"
                    Padding="0"
                    AutomationProperties.Name="Device actions"
                    ToolTipService.ToolTip="Device actions">
                    <FontIcon FontSize="14" Glyph="&#xF0E2;" />
                    <Button.Flyout>
                        <Flyout x:Name="DeviceActionsFlyout" Opened="PaneFlyout_Opened" ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="MinWidth" Value="320" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        x:Name="DndToggle"
                                        Grid.Column="0"
                                        Padding="8,4"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Do not disturb"
                                        Click="Dnd_Click"
                                        IsChecked="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay}"
                                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}">
                                        <FontIcon Glyph="&#xECE4;" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="RingToggle"
                                        Grid.Column="1"
                                        Padding="8,4"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind StatusViewModel.RingButtonText, Mode=OneWay}"
                                        Click="Ring_Click"
                                        IsChecked="{x:Bind StatusViewModel.IsRinging, Mode=OneWay}"
                                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                        ToolTipService.ToolTip="Ring the phone at full volume for up to 30 seconds">
                                        <Grid>
                                            <FontIcon Margin="-6,0,0,0" Glyph="&#xE8EA;" />
                                            <FontIcon Margin="6,0,-6,0" Glyph="&#xEBC5;" />
                                        </Grid>
                                    </ToggleButton>
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Do not disturb and Ring work while the phone is connected."
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind StatusViewModel.CanControl, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <TextBlock
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind StatusViewModel.StatusText, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind StatusViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <StackPanel>
                                    <Button Click="SendFilesAction_Click" Style="{StaticResource FlyoutRowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE72D;" />
                                            <TextBlock VerticalAlignment="Center" Text="Send files" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenReceivedFolderAction_Click" Style="{StaticResource FlyoutRowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xEC50;" />
                                            <TextBlock VerticalAlignment="Center" Text="Open received files" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OpenDeviceSettingsAction_Click" Style="{StaticResource FlyoutRowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE713;" />
                                            <TextBlock VerticalAlignment="Center" Text="Device settings" />
                                        </StackPanel>
                                    </Button>
                                    <!--  Sefirah has clipboard sync; Veyro does not have it yet.  -->
                                    <Button IsEnabled="False" Style="{StaticResource FlyoutRowButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xF0E3;" />
                                            <TextBlock VerticalAlignment="Center" Text="Send clipboard (not available yet)" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="ConnectionStatusButton"
                        Grid.Column="0"
                        Padding="12,0,12,0"
                        AutomationProperties.Name="Connection status"
                        BorderThickness="1,1,0,1"
                        CornerRadius="4,0,0,4"
                        Style="{StaticResource ConnectionSplitButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind ViewModel.Device.ConnectionStatusText, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="ConnectionFlyout" Opened="PaneFlyout_Opened" ShouldConstrainToRootBounds="False">
                                <StackPanel MaxWidth="340" Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.ConnectionHelpText, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Fingerprint" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--  Sefirah reconnects here. In Veyro the phone opens the link, so this re-reads discovery.  -->
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Look for the phone on the network"
                        Click="RefreshConnection_Click"
                        CornerRadius="0,4,4,0"
                        Style="{StaticResource ConnectionSplitButtonStyle}"
                        ToolTipService.ToolTip="Look for the phone on the network">
                        <FontIcon FontSize="14" Glyph="&#xE895;" />
                    </Button>
                </Grid>
            </StackPanel>
        </StackPanel>

        <TeachingTip
            x:Name="PhoneFrameScrollTeachingTip"
            Grid.Column="0"
            IsLightDismissEnabled="True"
            PreferredPlacement="Right"
            Subtitle="Scroll over the phone to switch between paired phones."
            Target="{x:Bind PhoneFrameGrid}"
            Title="Switch phones" />
    </Grid>
</UserControl>
