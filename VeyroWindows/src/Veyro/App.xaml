<Application
    x:Class="Veyro.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Pages are transparent so the Mica backdrop shows through  -->
            <SolidColorBrush x:Key="App.PageBackgroundBrush" Color="Transparent" />

            <!--  Shared look of the settings rows and cards (UserControls/SettingRow.xaml and the device cards)  -->
            <Style x:Key="RowSurfaceStyle" TargetType="Border">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
            </Style>
            <Style x:Key="SectionHeadingStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,22,0,6" />
            </Style>
            <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="RowTitleStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="RowHintStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!--  A bare switch at the end of a row; the row's title is its label  -->
            <Style x:Key="RowToggleStyle" TargetType="ToggleSwitch">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
            </Style>

            <!--  Theme-aware app icon (unplated, so no plate is drawn behind it)  -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <x:String x:Key="IconPath">ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-lightunplated.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <x:String x:Key="IconPath">ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png</x:String>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <x:String x:Key="IconPath">ms-appx:///Assets/Square44x44Logo.targetsize-256_altform-unplated.png</x:String>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
