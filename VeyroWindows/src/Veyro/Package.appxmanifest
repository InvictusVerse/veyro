<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  IgnorableNamespaces="uap uap5 desktop desktop2 desktop4 desktop5 rescap mp com">

  <Identity
    Name="Veyro.Windows"
    Publisher="CN=Veyro"
    Version="1.0.5.0" />

  <mp:PhoneIdentity PhoneProductId="9a6a5180-5120-4f7c-8e89-7252f712c9b0" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Veyro</DisplayName>
    <PublisherDisplayName>Veyro</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Veyro"
        Description="Fast, authenticated local file sharing and Android companion for Windows 11."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- URL protocol activation (veyro://) -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="veyro">
            <uap:DisplayName>Veyro</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>

        <!-- Windows Share Sheet target (ADR-039: handled in Program / ShareTargetActivation) -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget>
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType/>
            </uap:SupportedFileTypes>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- App notification (toast) activation for mirrored phone notifications (ADR-025).
             The CLSID must match in both elements. -->
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="0F2970E0-7A15-4C41-B2FE-A6F5A02B617A" />
        </desktop:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Veyro.exe" DisplayName="Veyro" Arguments="----AppNotificationActivated:">
              <com:Class Id="0F2970E0-7A15-4C41-B2FE-A6F5A02B617A" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>

        <!-- Optional "Send with Veyro" in the Explorer right-click menu (ADR-039). Out of process:
             Veyro.exe serves the IExplorerCommand (the running Veyro, or a windowless instance
             started with the argument below). Hidden unless the setting is on. The CLSID must
             match ExplorerCommandServer.CommandClsid in both elements. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Veyro.exe" DisplayName="Veyro Explorer menu" Arguments="-VeyroExplorerCommand">
              <com:Class Id="03FEE873-1C45-4C21-9509-78F1A3E62C1C" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="SendWithVeyro" Clsid="03FEE873-1C45-4C21-9509-78F1A3E62C1C" />
            </desktop5:ItemType>
            <!-- ADR-064: folders too, sent whole. -->
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="SendFolderWithVeyro" Clsid="03FEE873-1C45-4C21-9509-78F1A3E62C1C" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>

        <!-- Start with Windows (ADR-047): on by default; Veyro starts hidden in the tray. The user
             turns it off in Settings, the tray menu or Windows Settings > Apps > Startup. -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask
            TaskId="VeyroStartupTask"
            Enabled="true"
            DisplayName="Veyro" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <!-- The phone connects in on TCP 5150-5169. Windows creates this inbound rule (private
         networks only) when the package is installed and removes it on uninstall, so nobody
         is asked for administrator permission. The PowerShell rule in
         WindowsNetworkDiagnostics is only a one-time fallback if this one is missing. -->
    <desktop2:Extension Category="windows.firewallRules">
      <desktop2:FirewallRules Executable="Veyro.exe">
        <desktop2:Rule Direction="in" IPProtocol="TCP" LocalPortMin="5150" LocalPortMax="5169" Profile="private" />
      </desktop2:FirewallRules>
    </desktop2:Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <!-- Bluetooth hands-free call audio (ADR-029): PhoneLineTransportDevice, PhoneLine, PhoneCall -->
    <uap:Capability Name="phoneCall" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="phoneLineTransportManagement" />
    <DeviceCapability Name="bluetooth" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
