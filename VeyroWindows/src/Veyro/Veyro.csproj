<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Veyro</RootNamespace>
    <AssemblyName>Veyro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <!-- ADR-047, a small footprint while Veyro waits in the tray: no background GC thread (the
         heap is small, so a blocking collection is short), and the GC compacts more readily
         instead of keeping fragmented memory committed. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veyro.Core\Veyro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Declared explicitly so Visual Studio recognises this as a packaged MSIX project -->
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <!-- MSIX tile, splash, and store assets referenced by Package.appxmanifest -->
    <Content Include="Assets\**\*.png" />
    <!-- Icon of the optional Explorer "Send with Veyro" menu (ADR-039); built from the logo PNGs -->
    <Content Include="Assets\Veyro.ico" />
  </ItemGroup>
  <!-- ADR-067: the optional virtual camera DLL, built with MSVC by its own script (no MSBuild C++
       project) when its source changed, and shipped as VirtualCamera\VeyroVirtualCamera.dll. It is
       installed only when the user presses Set up. x64 only for now. -->
  <PropertyGroup>
    <VirtualCameraDir>$(MSBuildProjectDirectory)\..\VeyroVirtualCamera</VirtualCameraDir>
    <VirtualCameraDll>$(VirtualCameraDir)\bin\x64\VeyroVirtualCamera.dll</VirtualCameraDll>
  </PropertyGroup>
  <Target Name="BuildVirtualCamera" BeforeTargets="BeforeBuild"
          Inputs="$(VirtualCameraDir)\VeyroVirtualCamera.cpp;$(VirtualCameraDir)\VeyroVirtualCamera.def;$(VirtualCameraDir)\build.ps1"
          Outputs="$(VirtualCameraDll)"
          Condition="'$(Platform)' == 'x64' And Exists('D:\Microsoft\VisualStudio\VC\Tools\MSVC')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(VirtualCameraDir)\build.ps1&quot;" />
    <ItemGroup Condition="'@(VirtualCameraContent)' == ''">
      <Content Include="$(VirtualCameraDll)" Link="VirtualCamera\VeyroVirtualCamera.dll" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(Platform)' == 'x64' And Exists('$(VirtualCameraDll)')">
    <VirtualCameraContent Include="$(VirtualCameraDll)" />
    <Content Include="$(VirtualCameraDll)" Link="VirtualCamera\VeyroVirtualCamera.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-047: compact the large-object heap when it fragments, so trimmed memory stays trimmed. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>
</Project>
