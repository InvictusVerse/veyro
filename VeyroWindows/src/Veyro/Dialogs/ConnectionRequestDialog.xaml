<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Veyro.Dialogs.ConnectionRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pair with this phone?"
    CloseButtonText="Decline"
    DefaultButton="Close"
    PrimaryButtonText="Accept"
    Style="{ThemeResource DefaultContentDialogStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">460</x:Double>
    </ContentDialog.Resources>

    <StackPanel Spacing="14">

        <!--  Who is asking: phone icon beside its name and fingerprint  -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Width="52"
                Height="52"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="26">
                <FontIcon FontSize="24" Glyph="&#xE8EA;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="PhoneNameBlock"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PhoneFingerprintBlock"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    TextWrapping="Wrap"
                    ToolTipService.ToolTip="Device fingerprint. The phone shows the same one for itself in Settings." />
            </StackPanel>
        </Grid>

        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Your phone shows a pairing code too. Accept only if it is exactly this one:"
            TextWrapping="Wrap" />

        <!--  The code both screens must agree on  -->
        <Border
            Padding="16,18"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1.5"
            CornerRadius="8">
            <TextBlock
                x:Name="PairingCodeBlock"
                HorizontalAlignment="Center"
                CharacterSpacing="120"
                FontFamily="Cascadia Mono, Consolas"
                FontSize="44"
                FontWeight="SemiBold" />
        </Border>

        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="If the codes differ, decline: another device may be in between."
            TextWrapping="Wrap" />

        <!--  Time left before the request declines itself  -->
        <StackPanel Spacing="4">
            <ProgressBar
                x:Name="TimeLeftBar"
                AutomationProperties.Name="Time left to accept"
                Maximum="100"
                Minimum="0" />
            <TextBlock
                x:Name="TimeLeftBlock"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
