<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Veyro.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:userControls="using:Veyro.UserControls"
    Background="Transparent">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="SetupCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SetupNoteStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SetupButtonRowStyle" TargetType="StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="8" />
        </Style>
    </Page.Resources>

    <Grid>
        <!--  Top: progress dots and the step label. Below: the content of the current step.  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,44,0,0"
                HorizontalAlignment="Center"
                Spacing="6">
                <PipsPager
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Setup progress"
                    IsHitTestVisible="False"
                    NumberOfPages="4"
                    SelectedPageIndex="{x:Bind ViewModel.Step, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.StepText, Mode=OneWay}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!--  Step 1: welcome  -->
                    <StackPanel
                        MaxWidth="720"
                        Spacing="24"
                        Visibility="{x:Bind ViewModel.IsWelcome, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="56"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE8EA;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleLargeTextBlockStyle}"
                            Text="Welcome to Veyro" />
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="Veyro connects your Android phone to this PC. Send files both ways, see and answer your phone's notifications, read and reply to messages, control media and handle calls from here."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SetupCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon HorizontalAlignment="Left" Glyph="&#xE701;" />
                                    <TextBlock FontWeight="SemiBold" Text="Stays on your network" />
                                    <TextBlock Style="{StaticResource SetupNoteStyle}" Text="Your devices talk directly over Wi-Fi, Ethernet or a hotspot. Nothing goes through a cloud server." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SetupCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon HorizontalAlignment="Left" Glyph="&#xE72E;" />
                                    <TextBlock FontWeight="SemiBold" Text="Encrypted" />
                                    <TextBlock Style="{StaticResource SetupNoteStyle}" Text="You pair once with a one-time code. After that every connection is encrypted and both devices prove who they are." />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SetupCardStyle}">
                                <StackPanel Spacing="8">
                                    <FontIcon HorizontalAlignment="Left" Glyph="&#xE77B;" />
                                    <TextBlock FontWeight="SemiBold" Text="No account" />
                                    <TextBlock Style="{StaticResource SetupNoteStyle}" Text="No sign-up and no email. Your devices recognise each other by their own keys." />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Style="{StaticResource SetupButtonRowStyle}">
                            <Button
                                Click="NextStep_Click"
                                Content="Get started"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 2: install the Android app  -->
                    <StackPanel
                        MaxWidth="560"
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.IsGetApp, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Get Veyro on your phone" />
                        <TextBlock
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="Scan this with your phone's camera to open the download page, then install the APK from the latest release. Already installed? Continue."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Border
                            Width="220"
                            Height="220"
                            Padding="10"
                            HorizontalAlignment="Center"
                            Background="White"
                            CornerRadius="8">
                            <Image
                                x:Name="DownloadQrPicture"
                                AutomationProperties.Name="QR code for the Veyro Android download page"
                                Stretch="Uniform" />
                        </Border>
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            Content="github.com/InvictusVerse/veyro/releases"
                            NavigateUri="https://github.com/InvictusVerse/veyro/releases" />
                        <StackPanel Style="{StaticResource SetupButtonRowStyle}">
                            <Button Click="PreviousStep_Click" Content="Back" />
                            <Button
                                Click="NextStep_Click"
                                Content="I have the app"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 3: pair  -->
                    <StackPanel
                        MaxWidth="900"
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.IsPair, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Pair your phone" />
                        <userControls:PairingView />
                        <StackPanel Style="{StaticResource SetupButtonRowStyle}">
                            <Button Click="PreviousStep_Click" Content="Back" />
                            <Button
                                Click="FinishSetup_Click"
                                Content="Pair later"
                                ToolTipService.ToolTip="Finish setup now. You can pair from Settings at any time." />
                        </StackPanel>
                    </StackPanel>

                    <!--  Step 4: paired  -->
                    <StackPanel
                        MaxWidth="560"
                        Spacing="20"
                        Visibility="{x:Bind ViewModel.IsSuccess, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="56"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Glyph="&#xE930;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="Paired" />
                        <Border Style="{StaticResource SetupCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.PairedName, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontFamily="Consolas"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.PairedFingerprint, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SetupNoteStyle}" Text="This fingerprint matches the one your phone shows in Veyro settings. From now on the two devices connect on their own whenever they share a network." />
                            </StackPanel>
                        </Border>
                        <StackPanel Style="{StaticResource SetupButtonRowStyle}">
                            <Button
                                Click="SetUpBluetooth_Click"
                                Content="Set up Bluetooth calling (optional)"
                                ToolTipService.ToolTip="Hear and answer phone calls on this PC" />
                            <Button
                                Click="FinishSetup_Click"
                                Content="Finish"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <userControls:TitleBar HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Page>
