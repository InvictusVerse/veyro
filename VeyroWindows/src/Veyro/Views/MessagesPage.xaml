<!--
    Adapted from Sefirah (https://github.com/shrimqy/Sefirah), src/Sefirah/Views/MessagesPage.xaml, GPL-3.0.
    Modified for Veyro: Sefirah's conversation list and thread layout over MessagesViewModel (ADR-027).
-->
<Page
    x:Class="Veyro.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels"
    xmlns:views="using:Veyro.Views"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="IncomingMessageTemplate" x:DataType="viewModels:SmsMessageItemViewModel">
            <StackPanel
                MaxWidth="460"
                Margin="0,2"
                HorizontalAlignment="Left"
                Spacing="2">
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind SenderText, Mode=OneWay}"
                    Visibility="{x:Bind HasSender, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12,12,12,4">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Body, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <!--  Phone Link's Copy on a message; Ctrl+C still copies a selection.  -->
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="CopyMessage_Click" Tag="{x:Bind Body, Mode=OneWay}" Text="Copy">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </Border>
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind TimeText, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OutgoingMessageTemplate" x:DataType="viewModels:SmsMessageItemViewModel">
            <StackPanel
                MaxWidth="460"
                Margin="0,2"
                HorizontalAlignment="Right"
                Spacing="2">
                <Border
                    Padding="12,8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12,12,4,12">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Body, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="CopyMessage_Click" Tag="{x:Bind Body, Mode=OneWay}" Text="Copy">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </Border>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="4,0"
                        AutomationProperties.Name="Retry sending"
                        Click="Retry_Click"
                        Content="Retry"
                        FontSize="11"
                        Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <views:MessageTemplateSelector
            x:Key="MessageTemplateSelector"
            Incoming="{StaticResource IncomingMessageTemplate}"
            Outgoing="{StaticResource OutgoingMessageTemplate}" />
    </Page.Resources>

    <Grid>
        <!-- Phone not connected / feature off -->
        <StackPanel
            MaxWidth="440"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8BD;" />
            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Messages" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            ColumnSpacing="0"
            Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Thread list -->
            <Grid
                Grid.Column="0"
                Padding="16,16,12,16"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Messages" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Refresh conversations"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="New message"
                        Click="NewMessage_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="New message">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AutomationProperties.Name="Search conversations"
                    PlaceholderText="Search"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ProgressBar
                    Grid.Row="2"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoadingThreads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <ListView
                    x:Name="ThreadList"
                    Grid.Row="3"
                    AutomationProperties.Name="Conversations"
                    IsItemClickEnabled="True"
                    ItemClick="Thread_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Threads, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedThread, Mode=OneWay}"
                    SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SmsThreadItemViewModel">
                            <Grid Height="72" Padding="4,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                    CornerRadius="20">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Initial, Mode=OneWay}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind Snippet, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind TimeText, Mode=OneWay}" />
                                    <Border
                                        MinWidth="20"
                                        Padding="6,1"
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Unread messages"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="10"
                                        Visibility="{x:Bind HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="{x:Bind UnreadText, Mode=OneWay}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyThreadsText, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoThreads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!-- Conversation -->
            <StackPanel
                Grid.Column="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasNoConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8BD;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Select a conversation or start a new message"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Grid
                Grid.Column="1"
                Padding="16"
                RowSpacing="8"
                Visibility="{x:Bind ViewModel.HasConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ConversationSubtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasConversationSubtitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="LoadOlder_Click"
                        Content="Load older messages"
                        Visibility="{x:Bind ViewModel.CanLoadOlder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <ListView
                    x:Name="MessageList"
                    Grid.Row="2"
                    AutomationProperties.Name="Messages in conversation"
                    ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                    ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <!--  Right inset keeps outgoing bubbles clear of the overlay scroll bar.  -->
                            <Setter Property="Padding" Value="4,0,16,0" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    FontSize="12"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Grid.Row="4" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="SimPicker"
                        Grid.Column="0"
                        MinWidth="120"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="SIM to send from"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.Sims, Mode=OneWay}"
                        PlaceholderText="Default SIM"
                        SelectedItem="{x:Bind ViewModel.SelectedSim, Mode=OneWay}"
                        SelectionChanged="SimPicker_SelectionChanged"
                        Visibility="{x:Bind ViewModel.HasMultipleSims, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox
                        x:Name="ComposeBox"
                        Grid.Column="1"
                        MaxHeight="160"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Message text"
                        MaxLength="{x:Bind ViewModel.MaxBodyLength}"
                        PlaceholderText="Text message (Enter to send, Shift+Enter for a new line)"
                        PreviewKeyDown="ComposeBox_PreviewKeyDown"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Text="{x:Bind ViewModel.ComposeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Send message"
                        Click="Send_Click"
                        IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="Send">
                        <FontIcon FontSize="14" Glyph="&#xE724;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
