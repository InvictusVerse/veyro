<Page
    x:Class="Veyro.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels"
    xmlns:views="using:Veyro.Views"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="MessageMetaStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="MessageHintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Row of the conversation list: avatar initial, title and snippet, time and unread count  -->
        <DataTemplate x:Key="ThreadRowTemplate" x:DataType="viewModels:SmsThreadItemViewModel">
            <Grid Height="68" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                    CornerRadius="20">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{x:Bind Initial, Mode=OneWay}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="1"
                        Style="{StaticResource MessageMetaStyle}"
                        Text="{x:Bind Snippet, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Right"
                        Style="{StaticResource MessageMetaStyle}"
                        Text="{x:Bind TimeText, Mode=OneWay}" />
                    <Border
                        MinWidth="20"
                        Padding="6,1"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Unread messages"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="10"
                        Visibility="{x:Bind HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Text="{x:Bind UnreadText, Mode=OneWay}" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!--  Message from the other side: left aligned, neutral bubble, sender and time around it  -->
        <DataTemplate x:Key="IncomingMessageTemplate" x:DataType="viewModels:SmsMessageItemViewModel">
            <StackPanel
                MaxWidth="460"
                Margin="0,3"
                HorizontalAlignment="Left"
                Spacing="2">
                <TextBlock
                    Style="{StaticResource MessageMetaStyle}"
                    Text="{x:Bind SenderText, Mode=OneWay}"
                    Visibility="{x:Bind HasSender, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12,12,12,4">
                    <!--  Copy in the context menu, as on Phone Link; Ctrl+C still copies a selection  -->
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Body, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="CopyMessage_Click"
                                    Tag="{x:Bind Body, Mode=OneWay}"
                                    Text="Copy">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </Border>
                <TextBlock Style="{StaticResource MessageMetaStyle}" Text="{x:Bind TimeText, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <!--  Message sent from this PC: right aligned, accent bubble, delivery status and Retry below  -->
        <DataTemplate x:Key="OutgoingMessageTemplate" x:DataType="viewModels:SmsMessageItemViewModel">
            <StackPanel
                MaxWidth="460"
                Margin="0,3"
                HorizontalAlignment="Right"
                Spacing="2">
                <Border
                    Padding="12,8"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="12,12,4,12">
                    <TextBlock
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Body, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="CopyMessage_Click"
                                    Tag="{x:Bind Body, Mode=OneWay}"
                                    Text="Copy">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </TextBlock.ContextFlyout>
                    </TextBlock>
                </Border>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MessageMetaStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="4,0"
                        AutomationProperties.Name="Retry sending"
                        Click="Retry_Click"
                        Content="Retry"
                        FontSize="11"
                        Visibility="{x:Bind CanRetry, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <views:MessageTemplateSelector
            x:Key="MessageTemplateSelector"
            Incoming="{StaticResource IncomingMessageTemplate}"
            Outgoing="{StaticResource OutgoingMessageTemplate}" />
    </Page.Resources>

    <Grid>

        <!--  Phone not connected, or the feature is off  -->
        <StackPanel
            MaxWidth="440"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon
                FontSize="36"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE8BD;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Messages" />
            <TextBlock Style="{StaticResource MessageHintStyle}" Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}" />
        </StackPanel>

        <Grid Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left: conversation list with search  -->
            <Grid
                Grid.Column="0"
                Padding="16,16,12,12"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Text="Messages" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Refresh conversations"
                        Click="Refresh_Click"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.Name="New message"
                        Click="NewMessage_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        ToolTipService.ToolTip="New message">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <TextBox
                    Grid.Row="1"
                    AutomationProperties.Name="Search conversations"
                    PlaceholderText="Search"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <ProgressBar
                    Grid.Row="2"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ViewModel.IsLoadingThreads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Grid.Row="3">
                    <ListView
                        x:Name="ThreadList"
                        AutomationProperties.Name="Conversations"
                        IsItemClickEnabled="True"
                        ItemClick="Thread_ItemClick"
                        ItemTemplate="{StaticResource ThreadRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Threads, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedThread, Mode=OneWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource MessageHintStyle}"
                        Text="{x:Bind ViewModel.EmptyThreadsText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasNoThreads, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>

            <!--  Right: nothing selected yet  -->
            <StackPanel
                Grid.Column="1"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasNoConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon
                    FontSize="32"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8BD;" />
                <TextBlock Style="{StaticResource MessageHintStyle}" Text="Select a conversation or start a new message" />
            </StackPanel>

            <!--  Right: the open conversation  -->
            <Grid Grid.Column="1" Visibility="{x:Bind ViewModel.HasConversation, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Title bar of the conversation  -->
                <StackPanel
                    Grid.Row="0"
                    Padding="20,14"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Spacing="2">
                    <TextBlock
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ConversationTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Style="{StaticResource MessageMetaStyle}"
                        Text="{x:Bind ViewModel.ConversationSubtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasConversationSubtitle, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!--  Messages, with the "load older" control above them  -->
                <Grid Grid.Row="1" Padding="16,8,0,0" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Click="LoadOlder_Click"
                            Content="Load older messages"
                            Visibility="{x:Bind ViewModel.CanLoadOlder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ProgressRing
                            Width="20"
                            Height="20"
                            IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <ListView
                        x:Name="MessageList"
                        Grid.Row="1"
                        AutomationProperties.Name="Messages in conversation"
                        ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!--  The right inset keeps outgoing bubbles clear of the overlay scroll bar  -->
                                <Setter Property="Padding" Value="4,0,16,0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <!--  Send error (if any) and the compose bar  -->
                <StackPanel Grid.Row="2" Padding="16,8,16,16" Spacing="6">
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox
                            x:Name="SimPicker"
                            MinWidth="120"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="SIM to send from"
                            DisplayMemberPath="Label"
                            ItemsSource="{x:Bind ViewModel.Sims, Mode=OneWay}"
                            PlaceholderText="Default SIM"
                            SelectedItem="{x:Bind ViewModel.SelectedSim, Mode=OneWay}"
                            SelectionChanged="SimPicker_SelectionChanged"
                            Visibility="{x:Bind ViewModel.HasMultipleSims, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <TextBox
                            x:Name="ComposeBox"
                            Grid.Column="1"
                            MaxHeight="160"
                            AcceptsReturn="True"
                            AutomationProperties.Name="Message text"
                            MaxLength="{x:Bind ViewModel.MaxBodyLength}"
                            PlaceholderText="Text message (Enter to send, Shift+Enter for a new line)"
                            PreviewKeyDown="ComposeBox_PreviewKeyDown"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            Text="{x:Bind ViewModel.ComposeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />

                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Send message"
                            Click="Send_Click"
                            IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Send">
                            <FontIcon FontSize="14" Glyph="&#xE724;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
