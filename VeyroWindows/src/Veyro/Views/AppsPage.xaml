<Page
    x:Class="Veyro.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Padding="24">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xED35;" />
            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Apps" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mirror and launch Android apps from your PC" />
        </StackPanel>
    </Grid>
</Page>
