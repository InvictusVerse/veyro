<Page
    x:Class="Veyro.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Padding="24">
    <!--  Feature not built: an honest empty state, no sample apps.  -->
    <Grid>
        <StackPanel
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8">
            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xED35;" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="{x:Bind ViewModel.Title}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Text}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
