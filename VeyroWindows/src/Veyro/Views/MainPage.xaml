<!--
    Adapted from Sefirah (https://github.com/shrimqy/Sefirah), src/Sefirah/Views/MainPage.xaml, GPL-3.0.
    Modified for Veyro: Veyro view models, Transfers tab and banner, honest empty states.
-->
<Page
    x:Class="Veyro.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models"
    xmlns:userControls="using:Veyro.UserControls"
    xmlns:viewModels="using:Veyro.ViewModels"
    x:Name="PageRoot"
    Background="{ThemeResource App.PageBackgroundBrush}">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" Inverse="True" />
    </Page.Resources>

    <Grid
        AllowDrop="True"
        DragOver="Grid_DragOver"
        Drop="Page_Drop">
        <NavigationView
            x:Name="SideBar"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            LayoutUpdated="SideBar_LayoutUpdated"
            OpenPaneLength="360"
            PaneClosed="SideBar_PaneClosed"
            PaneClosing="SideBar_PaneClosing"
            PaneDisplayMode="Left"
            PaneOpening="SideBar_PaneOpening"
            SizeChanged="SideBar_SizeChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid
                    x:Name="PaneCustomRoot"
                    Padding="0,32,0,0"
                    VerticalAlignment="Stretch">

                    <!--  Compact rail (narrow window)  -->
                    <Grid
                        x:Name="CompactPaneContent"
                        Padding="0,4,0,8"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            Grid.Row="0"
                            Width="40"
                            Height="36"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Open side pane"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OpenSideBar_Click"
                            ToolTipService.ToolTip="Open side pane">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>
                        <!--  Collapsed rail: a small but well-proportioned phone (19.5:9, thicker
                              bezel, camera dot) instead of the squashed 24x44 one.  -->
                        <Button
                            Grid.Row="1"
                            Width="40"
                            Height="64"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OpenSideBar_Click"
                            CornerRadius="8"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Device.ConnectionStatusText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="28" Height="56">
                                <Border
                                    Background="#FF16161A"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="7" />
                                <Grid Margin="2.5" Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}">
                                    <Border CornerRadius="5">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0" Color="#FF2F5BEA" />
                                                <GradientStop Offset="0.55" Color="#FF4C8DF6" />
                                                <GradientStop Offset="1" Color="#FF7FC4FF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="5" Visibility="{x:Bind StatusViewModel.HasWallpaper, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind StatusViewModel.Wallpaper, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <!--  Camera dot  -->
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Fill="#FF16161A" />
                            </Grid>
                        </Button>
                        <ScrollViewer
                            Grid.Row="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemsSource="{x:Bind NotificationsViewModel.Notifications, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:NotificationItemViewModel">
                                        <Button
                                            Width="36"
                                            Height="36"
                                            Padding="4"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OpenSideBar_Click"
                                            CornerRadius="6"
                                            ToolTipService.ToolTip="{x:Bind AppName, Mode=OneWay}">
                                            <Grid>
                                                <Image
                                                    Width="28"
                                                    Height="28"
                                                    Source="{x:Bind Icon, Mode=OneWay}"
                                                    Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                                <FontIcon
                                                    FontSize="14"
                                                    Glyph="&#xE91C;"
                                                    Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!--  Expanded pane  -->
                    <Grid
                        x:Name="ExpandedPaneContent"
                        Margin="16,4,16,16"
                        VerticalAlignment="Stretch"
                        RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <userControls:DeviceControlCenter
                            Grid.Row="0"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <!--  Media card: only while the phone reports a session  -->
                            <Border
                                Margin="0,8,0,0"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{x:Bind MediaViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <userControls:MediaSessionsControl />
                            </Border>
                        </StackPanel>

                        <userControls:NotificationsControl
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!--  No phone paired: pair one, or pick a phone discovery sees  -->
                        <Grid
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Margin="0,20,0,0"
                            RowSpacing="12"
                            Visibility="{x:Bind ViewModel.HasNoActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="No phone paired" />
                            <StackPanel Grid.Row="1" Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Install Veyro on your Android phone, then pair it with this PC."
                                    TextWrapping="Wrap" />
                                <Button Click="PairPhone_Click" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xED14;" />
                                        <TextBlock Text="Pair a phone" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="2"
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Available devices" />

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscoveredDeviceUiModel">
                                                <Button
                                                    Padding="12"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Click="DiscoveredDevice_Click"
                                                    Tag="{x:Bind DeviceId}">
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon VerticalAlignment="Center" Glyph="&#xE8EA;" />
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                                            <TextBlock
                                                                FontSize="12"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="{x:Bind VerificationKey}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No phone with Veyro open is visible on this network. Keep both devices on the same Wi-Fi or hotspot."
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.HasNoDiscoveredDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Button
                            x:Name="CollapsePaneButton"
                            Grid.Row="0"
                            Width="40"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close side pane"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseSideBar_Click"
                            ToolTipService.ToolTip="Close side pane"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>
                    </Grid>
                </Grid>
            </NavigationView.PaneCustomContent>

            <Grid Margin="0,32,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <NavigationView
                    x:Name="MainNavigationView"
                    Grid.Row="0"
                    BorderBrush="Transparent"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True"
                    Loaded="MainNavigationView_Loaded"
                    PaneDisplayMode="Top"
                    SelectionChanged="NavigationView_SelectionChanged">
                    <NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </NavigationView.Resources>
                    <NavigationView.MenuItems>
                        <NavigationViewItem
                            x:Name="CallsNavigationItem"
                            Content="Calls"
                            Tag="Calls"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE717;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="MessagesNavigationItem"
                            Content="Messages"
                            Tag="Messages"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </NavigationViewItem.Icon>
                            <!--  Unread count, as on Phone Link's Messages tab  -->
                            <NavigationViewItem.InfoBadge>
                                <InfoBadge
                                    AutomationProperties.Name="Unread messages"
                                    Visibility="{x:Bind MessagesViewModel.HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Value="{x:Bind MessagesViewModel.UnreadCount, Mode=OneWay}" />
                            </NavigationViewItem.InfoBadge>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="TransfersNavigationItem"
                            Content="Transfers"
                            Tag="Transfers">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE898;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem
                            x:Name="PhotosNavigationItem"
                            Content="Photos"
                            Tag="Photos"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE91B;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>

                <!--  Single authoritative active-transfer banner  -->
                <userControls:ActiveTransferBanner Grid.Row="1" />

                <Frame
                    x:Name="ContentFrame"
                    Grid.Row="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0" />
            </Grid>
        </NavigationView>

        <userControls:TitleBar
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />
    </Grid>
</Page>
