<Page
    x:Class="Veyro.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models"
    xmlns:userControls="using:Veyro.UserControls"
    xmlns:viewModels="using:Veyro.ViewModels"
    Background="{ThemeResource App.PageBackgroundBrush}">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  One small button per phone notification in the collapsed rail  -->
        <DataTemplate x:Key="RailNotificationTemplate" x:DataType="viewModels:NotificationItemViewModel">
            <Button
                Width="36"
                Height="36"
                Padding="4"
                HorizontalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Click="PaneOpenRequested"
                CornerRadius="6"
                ToolTipService.ToolTip="{x:Bind AppName, Mode=OneWay}">
                <Grid>
                    <Image
                        Width="28"
                        Height="28"
                        Source="{x:Bind Icon, Mode=OneWay}"
                        Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                    <FontIcon
                        FontSize="14"
                        Glyph="&#xE91C;"
                        Visibility="{x:Bind HasNoIcon, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <!--  A phone that discovery sees but that is not paired yet  -->
        <DataTemplate x:Key="NearbyPhoneTemplate" x:DataType="models:DiscoveredDeviceUiModel">
            <Button
                Padding="12"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="NearbyPhone_Click"
                Tag="{x:Bind DeviceId}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon VerticalAlignment="Center" Glyph="&#xE8EA;" />
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind VerificationKey}" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid
        AllowDrop="True"
        DragOver="FilesDragOver"
        Drop="FilesDropped">

        <!--  Outer view: the phone pane on the left, the tabbed workspace on the right  -->
        <NavigationView
            x:Name="PhonePane"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            LayoutUpdated="PhonePane_LayoutUpdated"
            OpenPaneLength="360"
            PaneClosed="PhonePane_PaneClosed"
            PaneClosing="PhonePane_PaneClosing"
            PaneDisplayMode="Left"
            PaneOpening="PhonePane_PaneOpening"
            SizeChanged="PhonePane_SizeChanged">
            <NavigationView.Resources>
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <Grid x:Name="PaneHost" Padding="0,32,0,0">

                    <!--  Collapsed rail: open button, a small phone, one button per notification  -->
                    <Grid
                        x:Name="RailView"
                        Padding="0,4,0,8"
                        RowSpacing="8"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button
                            Grid.Row="0"
                            Width="40"
                            Height="36"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Open side pane"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PaneOpenRequested"
                            ToolTipService.ToolTip="Open side pane">
                            <FontIcon Glyph="&#xE76C;" />
                        </Button>

                        <Button
                            Grid.Row="1"
                            Width="40"
                            Height="64"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PaneOpenRequested"
                            CornerRadius="8"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Device.ConnectionStatusText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Width="28" Height="56">
                                <Border
                                    Background="#FF16161A"
                                    BorderBrush="#40FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="7" />
                                <Border
                                    Margin="2.5"
                                    CornerRadius="5"
                                    Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Offset="0" Color="#FF2F5BEA" />
                                            <GradientStop Offset="0.55" Color="#FF4C8DF6" />
                                            <GradientStop Offset="1" Color="#FF7FC4FF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border CornerRadius="5" Visibility="{x:Bind StatusViewModel.HasWallpaper, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind StatusViewModel.Wallpaper, Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Border>
                                <Ellipse
                                    Width="3"
                                    Height="3"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Fill="#FF16161A" />
                            </Grid>
                        </Button>

                        <ScrollViewer
                            Grid.Row="2"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater ItemTemplate="{StaticResource RailNotificationTemplate}" ItemsSource="{x:Bind NotificationsViewModel.Notifications, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="4" />
                                </ItemsRepeater.Layout>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!--  Full pane: either the phone panel or, without a phone, the pairing prompt  -->
                    <Grid x:Name="FullPaneView" Margin="16,4,16,16">

                        <Grid
                            RowSpacing="12"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <userControls:DeviceControlCenter Grid.Row="0" />

                            <StackPanel Grid.Row="1" Spacing="8">
                                <Rectangle Height="1" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <!--  Shown only while the phone reports a media session  -->
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{x:Bind MediaViewModel.HasSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <userControls:MediaSessionsControl />
                                </Border>
                            </StackPanel>

                            <userControls:NotificationsControl Grid.Row="2" />
                        </Grid>

                        <Grid
                            Margin="0,20,0,0"
                            RowSpacing="12"
                            Visibility="{x:Bind ViewModel.HasNoActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Spacing="8">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="No phone paired" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Install Veyro on your Android phone, then pair it with this PC."
                                    TextWrapping="Wrap" />
                                <Button Click="PairPhone_Click" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xED14;" />
                                        <TextBlock Text="Pair a phone" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock
                                Grid.Row="1"
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Available devices" />

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <ItemsRepeater ItemTemplate="{StaticResource NearbyPhoneTemplate}" ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Vertical" Spacing="8" />
                                        </ItemsRepeater.Layout>
                                    </ItemsRepeater>
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="No phone with Veyro open is visible on this network. Keep both devices on the same Wi-Fi or hotspot."
                                        TextWrapping="Wrap"
                                        Visibility="{x:Bind ViewModel.HasNoDiscoveredDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!--  Only offered when the pane is an overlay (narrow window)  -->
                        <Button
                            x:Name="ClosePaneButton"
                            Width="40"
                            Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Close side pane"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PaneCloseRequested"
                            ToolTipService.ToolTip="Close side pane"
                            Visibility="Collapsed">
                            <FontIcon Glyph="&#xE76B;" />
                        </Button>
                    </Grid>
                </Grid>
            </NavigationView.PaneCustomContent>

            <!--  Workspace: tab strip, transfer banner, then the page of the selected tab  -->
            <Grid Margin="0,32,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <NavigationView
                    x:Name="TabBar"
                    Grid.Row="0"
                    BorderBrush="Transparent"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="True"
                    Loaded="TabBar_Loaded"
                    PaneDisplayMode="Top"
                    SelectionChanged="TabBar_SelectionChanged">
                    <NavigationView.Resources>
                        <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                    </NavigationView.Resources>
                    <NavigationView.MenuItems>
                        <NavigationViewItem
                            x:Name="CallsTab"
                            Content="Calls"
                            Tag="Calls"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE717;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem
                            x:Name="MessagesTab"
                            Content="Messages"
                            Tag="Messages"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </NavigationViewItem.Icon>
                            <!--  Unread count on the tab, as on Phone Link  -->
                            <NavigationViewItem.InfoBadge>
                                <InfoBadge
                                    AutomationProperties.Name="Unread messages"
                                    Visibility="{x:Bind MessagesViewModel.HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Value="{x:Bind MessagesViewModel.UnreadCount, Mode=OneWay}" />
                            </NavigationViewItem.InfoBadge>
                        </NavigationViewItem>

                        <NavigationViewItem
                            x:Name="TransfersTab"
                            Content="Transfers"
                            Tag="Transfers">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE898;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <NavigationViewItem
                            x:Name="PhotosTab"
                            Content="Photos"
                            Tag="Photos"
                            Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE91B;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>

                        <!--  ADR-043: Veyro's virtual clipboard  -->
                        <NavigationViewItem
                            x:Name="ClipboardTab"
                            Content="Clipboard"
                            Tag="Clipboard">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xF0E3;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationView.MenuItems>
                </NavigationView>

                <!--  The one place that shows the running transfer  -->
                <userControls:ActiveTransferBanner Grid.Row="1" />

                <Frame
                    x:Name="TabContent"
                    Grid.Row="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="10,0,0,0" />
            </Grid>
        </NavigationView>

        <userControls:TitleBar HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</Page>
