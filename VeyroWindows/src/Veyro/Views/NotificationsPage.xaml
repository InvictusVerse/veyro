<!--  ADR-074: the phone's notifications as a page of the Modern layout (Classic shows them in the side pane).  -->
<Page
    x:Class="Veyro.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:userControls="using:Veyro.UserControls">
    <Grid MaxWidth="760" Padding="24,20,24,0">
        <userControls:NotificationsControl />
    </Grid>
</Page>
