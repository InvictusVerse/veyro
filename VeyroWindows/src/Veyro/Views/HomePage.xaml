<!--
    ADR-074: Modern Home, laid out like NectarLink. Left: the phone card with what is playing, the
    main actions, and the notification feed (reply, actions, history, this PC's pop-up pause in its
    bell). Right: phone controls (the phone's own DND, flashlight, sound, volume, brightness, PC
    sound on phone), camera tools, and a timeline of recent transfers. Every value is reported by
    the phone or the session registry; with no phone the page offers pairing instead.
-->
<Page
    x:Class="Veyro.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:models="using:Veyro.Data.Models"
    xmlns:userControls="using:Veyro.UserControls"
    xmlns:viewModels="using:Veyro.ViewModels">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Width" Value="148" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--  Action tile: icon badge top-left, label bottom-left  -->
        <Style x:Key="ActionTileStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="84" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
        </Style>

        <!--  Small square icon button in a tile's top-right corner  -->
        <Style x:Key="CornerButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!--  Phone control: rounded square toggle with the label under the icon  -->
        <Style x:Key="ControlToggleStyle" BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="ControlButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="20,8,20,20">

        <!--  ── A paired phone ──  -->
        <Grid ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.75*" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!--  Left column  -->
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Phone card: picture, name, chips | now playing  -->
                <Border Padding="18" Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>

                        <Grid
                            x:Name="PhoneFrame"
                            Width="84"
                            Height="168"
                            AutomationProperties.Name="Mirror the phone's screen"
                            PointerEntered="PhoneFrame_PointerEntered"
                            PointerExited="PhoneFrame_PointerExited"
                            PointerWheelChanged="PhoneFrame_PointerWheelChanged"
                            Tapped="PhoneFrame_Tapped"
                            ToolTipService.ToolTip="Click to mirror the phone's screen">
                            <Border
                                Background="#FF1B1B1F"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16" />
                            <Grid Margin="4" Opacity="{x:Bind ViewModel.Device.StatusOpacity, Mode=OneWay, FallbackValue=0.4}">
                                <Border CornerRadius="12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#FF3A4A6B" />
                                            <GradientStop Offset="1" Color="#FF22293A" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="12" Visibility="{x:Bind StatusViewModel.HasWallpaper, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{x:Bind StatusViewModel.Wallpaper, Mode=OneWay}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Ellipse
                                    Width="5"
                                    Height="5"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Fill="#FF0B0B0E" />
                            </Grid>
                            <Border
                                x:Name="PhoneOverlay"
                                Margin="4"
                                Background="#99000000"
                                CornerRadius="12"
                                Opacity="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <FontIcon FontSize="20" Foreground="White" Glyph="&#xEC15;" />
                                    <TextBlock FontSize="10" Foreground="White" Text="Mirror" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="10">
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.Device.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.HasSingleDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ComboBox
                                Margin="-10,0,0,0"
                                AutomationProperties.Name="Phone shown in Veyro"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="20"
                                FontWeight="SemiBold"
                                ItemsSource="{x:Bind ViewModel.PairedDevices, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.Device, Mode=TwoWay}"
                                Visibility="{x:Bind ViewModel.HasMultipleDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:PairedDeviceUiModel">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!--  As in Classic: connection, then one icon per reported value; details in each tooltip  -->
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <Button
                                    Height="30"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Connection details"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    CornerRadius="15">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Grid Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Ellipse Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind ViewModel.IsConnecting, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Ellipse Fill="{ThemeResource SystemFillColorNeutralBrush}" Visibility="{x:Bind ViewModel.IsOffline, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="{x:Bind ViewModel.ConnectionPillText, Mode=OneWay}" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout>
                                            <StackPanel MaxWidth="340" Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.ConnectionHelpText, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind ViewModel.NetworkText, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Fingerprint" />
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay}"
                                                    TextWrapping="Wrap" />
                                                <Button Click="Reconnect_Click" Content="Reconnect" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind StatusViewModel.BluetoothLabel, Mode=OneWay}"
                                    FontSize="16"
                                    Glyph="&#xE702;"
                                    Opacity="{x:Bind StatusViewModel.BluetoothOpacity, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind StatusViewModel.BluetoothLabel, Mode=OneWay}"
                                    Visibility="{x:Bind StatusViewModel.HasBluetooth, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind StatusViewModel.WifiLabel, Mode=OneWay}"
                                    FontSize="16"
                                    Glyph="{x:Bind StatusViewModel.WifiGlyph, Mode=OneWay}"
                                    Opacity="{x:Bind StatusViewModel.WifiOpacity, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind StatusViewModel.WifiLabel, Mode=OneWay}"
                                    Visibility="{x:Bind StatusViewModel.HasWifi, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind StatusViewModel.CellLabel, Mode=OneWay}"
                                    FontSize="16"
                                    Glyph="{x:Bind StatusViewModel.CellGlyph, Mode=OneWay}"
                                    Opacity="{x:Bind StatusViewModel.CellOpacity, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind StatusViewModel.CellLabel, Mode=OneWay}"
                                    Visibility="{x:Bind StatusViewModel.HasCell, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                                    FontSize="16"
                                    Glyph="&#xE708;"
                                    ToolTipService.ToolTip="{x:Bind StatusViewModel.DndLabel, Mode=OneWay}"
                                    Visibility="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <StackPanel
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    ToolTipService.ToolTip="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                                    Visibility="{x:Bind StatusViewModel.HasBattery, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind StatusViewModel.BatteryText, Mode=OneWay}" />
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind StatusViewModel.BatteryLabel, Mode=OneWay}"
                                        FontSize="16"
                                        Glyph="{x:Bind StatusViewModel.BatteryGlyph, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle
                            Grid.Column="2"
                            Width="1"
                            Margin="0,6"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!--  Now playing on the phone  -->
                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <userControls:MediaSessionsControl />
                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="{x:Bind MediaViewModel.HasNoSession, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <FontIcon HorizontalAlignment="Left" FontSize="22" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xEC4F;" />
                                <TextBlock FontWeight="SemiBold" Text="Nothing playing" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Music and videos playing on the phone show here with controls."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Main actions  -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Button
                            AutomationProperties.Name="Mirror screen"
                            Click="Mirror_Click"
                            IsEnabled="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay}"
                            Style="{StaticResource ActionTileStyle}">
                            <Grid>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xEC15;" />
                                </Border>
                                <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="Mirror screen" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Grid Grid.Column="1">
                        <Button
                            AutomationProperties.Name="Send files"
                            Click="SendFiles_Click"
                            Style="{StaticResource ActionTileStyle}"
                            ToolTipService.ToolTip="Send files (or drop them on this window)">
                            <Grid>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE724;" />
                                </Border>
                                <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="Send files" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button
                            Margin="0,10,10,0"
                            AutomationProperties.Name="Send folder"
                            Click="SendFolder_Click"
                            Style="{StaticResource CornerButtonStyle}"
                            ToolTipService.ToolTip="Send a whole folder">
                            <FontIcon FontSize="15" Glyph="&#xE8B7;" />
                        </Button>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Button
                            AutomationProperties.Name="Send clipboard"
                            Click="SendClipboard_Click"
                            IsEnabled="{x:Bind ViewModel.IsDeviceConnected, Mode=OneWay}"
                            Style="{StaticResource ActionTileStyle}"
                            ToolTipService.ToolTip="Send the text on this PC's clipboard to the phone">
                            <Grid>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE77F;" />
                                </Border>
                                <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="Send clipboard" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button
                            Margin="0,10,10,0"
                            AutomationProperties.Name="Clipboard history"
                            Click="ClipboardPage_Click"
                            Style="{StaticResource CornerButtonStyle}"
                            ToolTipService.ToolTip="Clipboard history">
                            <FontIcon FontSize="15" Glyph="&#xF0E3;" />
                        </Button>
                    </Grid>

                    <ToggleButton
                        x:Name="RingToggle"
                        Grid.Column="3"
                        Height="84"
                        Padding="14,12"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind StatusViewModel.RingButtonText, Mode=OneWay}"
                        Click="Ring_Click"
                        CornerRadius="16"
                        IsChecked="{x:Bind StatusViewModel.IsRinging, Mode=OneWay}"
                        IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                        ToolTipService.ToolTip="Ring the phone at full volume for up to 30 seconds">
                        <Grid>
                            <Border Style="{StaticResource BadgeStyle}">
                                <FontIcon FontSize="14" Glyph="&#xEA8F;" />
                            </Border>
                            <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="{x:Bind FindText(StatusViewModel.IsRinging), Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </ToggleButton>
                </Grid>

                <!--  Notifications: the full feed with reply, actions, history and the PC pop-up pause  -->
                <Border
                    Grid.Row="2"
                    Padding="16,14,16,4"
                    Style="{StaticResource CardStyle}">
                    <userControls:NotificationsControl />
                </Border>
            </Grid>

            <!--  Right column  -->
            <Grid Grid.Column="1" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Phone controls (ADR-038, ADR-060, ADR-073): a click is a request; the phone's report decides  -->
                <Border Padding="16" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Phone controls" />
                            <Button
                                x:Name="SoundDisplayButton"
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Sound and display"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}">
                                <TextBlock FontSize="13" Text="Sound and display" />
                                <Button.Flyout>
                                    <Flyout>
                                        <StackPanel Width="290" Spacing="10">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sound and display" />
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton
                                                    x:Name="RingerNormalToggle"
                                                    Padding="6"
                                                    HorizontalAlignment="Stretch"
                                                    Click="RingerNormal_Click"
                                                    IsChecked="{x:Bind StatusViewModel.IsRingerNormal, Mode=OneWay}">
                                                    <StackPanel Spacing="4">
                                                        <FontIcon Glyph="&#xEA8F;" />
                                                        <TextBlock FontSize="12" HorizontalAlignment="Center" Text="Ring" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton
                                                    x:Name="RingerVibrateToggle"
                                                    Grid.Column="1"
                                                    Padding="6"
                                                    HorizontalAlignment="Stretch"
                                                    Click="RingerVibrate_Click"
                                                    IsChecked="{x:Bind StatusViewModel.IsRingerVibrate, Mode=OneWay}">
                                                    <StackPanel Spacing="4">
                                                        <FontIcon Glyph="&#xE877;" />
                                                        <TextBlock FontSize="12" HorizontalAlignment="Center" Text="Vibrate" />
                                                    </StackPanel>
                                                </ToggleButton>
                                                <ToggleButton
                                                    x:Name="RingerSilentToggle"
                                                    Grid.Column="2"
                                                    Padding="6"
                                                    HorizontalAlignment="Stretch"
                                                    Click="RingerSilent_Click"
                                                    IsChecked="{x:Bind StatusViewModel.IsRingerSilent, Mode=OneWay}">
                                                    <StackPanel Spacing="4">
                                                        <FontIcon Glyph="&#xE7ED;" />
                                                        <TextBlock FontSize="12" HorizontalAlignment="Center" Text="Silent" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </Grid>
                                            <ToggleSwitch
                                                Header="Automatic brightness"
                                                IsEnabled="{x:Bind StatusViewModel.CanBrightness, Mode=OneWay}"
                                                IsOn="{x:Bind StatusViewModel.IsAutoBrightness, Mode=OneWay}"
                                                Toggled="AutoBrightness_Toggled" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  The phone's own Do not disturb (not this PC's pop-ups: that is the bell on Notifications)  -->
                            <ToggleButton
                                x:Name="PhoneDndToggle"
                                AutomationProperties.Name="{x:Bind StatusViewModel.DndButtonLabel, Mode=OneWay}"
                                Click="PhoneDnd_Click"
                                IsChecked="{x:Bind StatusViewModel.IsDndOn, Mode=OneWay}"
                                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                Style="{StaticResource ControlToggleStyle}"
                                ToolTipService.ToolTip="{x:Bind StatusViewModel.DndButtonLabel, Mode=OneWay}">
                                <StackPanel Spacing="3">
                                    <FontIcon FontSize="16" Glyph="&#xE708;" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Text="DND" />
                                </StackPanel>
                            </ToggleButton>
                            <Grid Grid.Column="1" Background="Transparent" ToolTipService.ToolTip="{x:Bind StatusViewModel.TorchTip, Mode=OneWay}">
                                <ToggleButton
                                    x:Name="TorchToggle"
                                    AutomationProperties.Name="{x:Bind StatusViewModel.TorchTip, Mode=OneWay}"
                                    Click="Torch_Click"
                                    IsChecked="{x:Bind StatusViewModel.IsTorchOn, Mode=OneWay}"
                                    IsEnabled="{x:Bind StatusViewModel.CanTorch, Mode=OneWay}"
                                    Style="{StaticResource ControlToggleStyle}">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontSize="16" Glyph="&#xEA80;" />
                                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Torch" />
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>
                            <ToggleButton
                                x:Name="SilentToggle"
                                Grid.Column="2"
                                AutomationProperties.Name="Silent"
                                Click="SilentTile_Click"
                                IsChecked="{x:Bind StatusViewModel.IsRingerSilent, Mode=OneWay}"
                                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                Style="{StaticResource ControlToggleStyle}"
                                ToolTipService.ToolTip="{x:Bind StatusViewModel.SoundLabel, Mode=OneWay}">
                                <StackPanel Spacing="3">
                                    <FontIcon FontSize="16" Glyph="&#xE7ED;" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Silent" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton
                                x:Name="VibrateToggle"
                                Grid.Column="3"
                                AutomationProperties.Name="Vibrate"
                                Click="VibrateTile_Click"
                                IsChecked="{x:Bind StatusViewModel.IsRingerVibrate, Mode=OneWay}"
                                IsEnabled="{x:Bind StatusViewModel.CanControl, Mode=OneWay}"
                                Style="{StaticResource ControlToggleStyle}"
                                ToolTipService.ToolTip="{x:Bind StatusViewModel.SoundLabel, Mode=OneWay}">
                                <StackPanel Spacing="3">
                                    <FontIcon FontSize="16" Glyph="&#xE877;" />
                                    <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Vibrate" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>

                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Media volume" />
                                            <Slider
                                                AutomationProperties.Name="Phone media volume"
                                                IsEnabled="{x:Bind StatusViewModel.CanVolume, Mode=OneWay}"
                                                Maximum="100"
                                                Minimum="0"
                                                StepFrequency="1"
                                                Value="{x:Bind StatusViewModel.ShownMediaVolume, Mode=OneWay}"
                                                ValueChanged="Volume_ValueChanged" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Screen brightness" />
                                            <Slider
                                                AutomationProperties.Name="Phone screen brightness"
                                                IsEnabled="{x:Bind StatusViewModel.CanBrightness, Mode=OneWay}"
                                                Maximum="100"
                                                Minimum="0"
                                                StepFrequency="1"
                                                Value="{x:Bind StatusViewModel.ShownBrightness, Mode=OneWay}"
                                                ValueChanged="Brightness_ValueChanged" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon VerticalAlignment="Center" FontSize="15" Glyph="&#xE7F5;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="13" Text="PC sound on phone" />
                                <TextBlock
                                    x:Name="SpeakerText"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Play this PC's sound through the phone" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SpeakerSwitch"
                                Grid.Column="2"
                                MinWidth="0"
                                AutomationProperties.Name="PC sound on phone"
                                OffContent=""
                                OnContent=""
                                Toggled="SpeakerSwitch_Toggled">
                                <!--  The default reserves 154 px for a label; this switch has none  -->
                                <ToggleSwitch.Resources>
                                    <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
                                    <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
                                </ToggleSwitch.Resources>
                            </ToggleSwitch>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Camera tools (ADR-067, ADR-073)  -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Button
                            x:Name="PhotoTile"
                            AutomationProperties.Name="Take photo with phone"
                            Click="TakePhoto_Click"
                            Style="{StaticResource ActionTileStyle}"
                            ToolTipService.ToolTip="Take a photo on the phone; it lands on this PC's clipboard (Ctrl+Alt+C). The corner button scans a document (Ctrl+Alt+D).">
                            <Grid>
                                <Border Style="{StaticResource BadgeStyle}">
                                    <FontIcon FontSize="14" Glyph="&#xE722;" />
                                </Border>
                                <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="Snap to PC" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="ScanButton"
                            Margin="0,10,10,0"
                            AutomationProperties.Name="Scan document with phone"
                            Click="Scan_Click"
                            Style="{StaticResource CornerButtonStyle}"
                            ToolTipService.ToolTip="Scan a document (Ctrl+Alt+D)">
                            <FontIcon FontSize="15" Glyph="&#xE8A5;" />
                        </Button>
                    </Grid>
                    <Button
                        x:Name="WebcamTile"
                        Grid.Column="1"
                        AutomationProperties.Name="Phone as webcam"
                        Click="Webcam_Click"
                        Style="{StaticResource ActionTileStyle}">
                        <Grid>
                            <Border Style="{StaticResource BadgeStyle}">
                                <FontIcon FontSize="14" Glyph="&#xE714;" />
                            </Border>
                            <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="Phone as webcam" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Button>
                </Grid>

                <!--  Timeline: recent transfers  -->
                <Border
                    Grid.Row="2"
                    Padding="16"
                    Style="{StaticResource CardStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource CardTitleStyle}" Text="Timeline" />
                            <Button
                                Padding="6,2"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ViewAll_Click"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}">
                                <TextBlock FontSize="13" Text="View all" />
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsRepeater ItemsSource="{x:Bind Timeline}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:TransferHistoryItemViewModel">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon
                                                    VerticalAlignment="Top"
                                                    FontSize="14"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Glyph="{x:Bind Glyph}" />
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                                <TextBlock
                                    x:Name="TimelineEmpty"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Files you send or receive show here."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  ── No phone paired: pair one, or pick a phone discovery sees ──  -->
        <Border
            MaxWidth="620"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource CardStyle}"
            Visibility="{x:Bind ViewModel.HasNoActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Spacing="12">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="No phone paired" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Install Veyro on your Android phone, then pair it with this PC."
                    TextWrapping="Wrap" />
                <Button
                    HorizontalAlignment="Left"
                    Click="PairPhone_Click"
                    CornerRadius="18"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xED14;" />
                        <TextBlock Text="Pair a phone" />
                    </StackPanel>
                </Button>
                <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Available devices" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DiscoveredDevices, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DiscoveredDeviceUiModel">
                            <Button
                                Padding="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="DiscoveredDevice_Click"
                                CornerRadius="12"
                                Tag="{x:Bind DeviceId}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon VerticalAlignment="Center" Glyph="&#xE8EA;" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind VerificationKey}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No phone with Veyro open is visible on this network. Keep both devices on the same Wi-Fi or hotspot."
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoDiscoveredDevices, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
