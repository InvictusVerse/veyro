<!--
    ADR-074: the Modern layout's window, laid out like NectarLink. A narrow rail with the label
    under each icon (Home, Messages, Calls, Photos, Transfers, Clipboard; Settings at the bottom)
    and the page. The Classic layout is MainPage; Settings > General > Layout switches.
-->
<Page
    x:Class="Veyro.Views.ModernShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:userControls="using:Veyro.UserControls"
    Background="{ThemeResource App.PageBackgroundBrush}">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="RailButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Page.Resources>

    <Grid
        AllowDrop="True"
        DragOver="Root_DragOver"
        Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <userControls:TitleBar
            Grid.Row="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <!--  Rail  -->
        <Grid Grid.Row="1" Padding="0,4,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="RailItems" Spacing="4">
                <Button x:Name="HomeItem" Click="Rail_Click" Style="{StaticResource RailButtonStyle}" Tag="Home" AutomationProperties.Name="Home">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="18" Glyph="&#xE80F;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Home" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="MessagesItem"
                    AutomationProperties.Name="Messages"
                    Click="Rail_Click"
                    Style="{StaticResource RailButtonStyle}"
                    Tag="Messages"
                    Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel Spacing="3">
                            <FontIcon FontSize="18" Glyph="&#xE8BD;" />
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Messages" />
                        </StackPanel>
                        <InfoBadge
                            Margin="0,-2,-6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="{x:Bind MessagesViewModel.HasUnread, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Value="{x:Bind MessagesViewModel.UnreadCount, Mode=OneWay}" />
                    </Grid>
                </Button>
                <Button
                    x:Name="CallsItem"
                    AutomationProperties.Name="Calls"
                    Click="Rail_Click"
                    Style="{StaticResource RailButtonStyle}"
                    Tag="Calls"
                    Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="18" Glyph="&#xE717;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Calls" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="PhotosItem"
                    AutomationProperties.Name="Photos"
                    Click="Rail_Click"
                    Style="{StaticResource RailButtonStyle}"
                    Tag="Photos"
                    Visibility="{x:Bind ViewModel.HasActiveDevice, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="18" Glyph="&#xE91B;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Photos" />
                    </StackPanel>
                </Button>
                <Button x:Name="TransfersItem" Click="Rail_Click" Style="{StaticResource RailButtonStyle}" Tag="Transfers" AutomationProperties.Name="Transfers">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="18" Glyph="&#xE898;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Transfers" />
                    </StackPanel>
                </Button>
                <Button x:Name="ClipboardItem" Click="Rail_Click" Style="{StaticResource RailButtonStyle}" Tag="Clipboard" AutomationProperties.Name="Clipboard">
                    <StackPanel Spacing="3">
                        <FontIcon FontSize="18" Glyph="&#xF0E3;" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Clipboard" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Button
                x:Name="SettingsItem"
                Grid.Row="1"
                AutomationProperties.Name="Settings"
                Click="Rail_Click"
                Style="{StaticResource RailButtonStyle}"
                Tag="Settings">
                <StackPanel Spacing="3">
                    <FontIcon FontSize="18" Glyph="&#xE713;" />
                    <TextBlock HorizontalAlignment="Center" FontSize="11" Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Page  -->
        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0"
            CornerRadius="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="PageTitle"
                Margin="24,14,0,4"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Home" />
            <userControls:ActiveTransferBanner Grid.Row="1" />
            <Frame x:Name="ContentFrame" Grid.Row="2" />
        </Grid>
    </Grid>
</Page>
