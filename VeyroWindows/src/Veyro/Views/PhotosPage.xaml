<!--
    Photos tab (ADR-034), laid out like Phone Link's: a header with the count and Refresh, then a
    virtualized grid of square thumbnails grouped by day, newest first. Clicking a tile opens the
    viewer over the grid. Original Veyro markup.
-->
<Page
    x:Class="Veyro.Views.PhotosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Veyro.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <CollectionViewSource x:Name="PhotoGroups" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar
            Grid.Row="0"
            Margin="16,12,16,0"
            IsOpen="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            Severity="Informational"
            Closed="Status_Closed" />

        <!--  Not paired / not connected / phone does not share photos  -->
        <StackPanel
            Grid.Row="1"
            MaxWidth="440"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay}">
            <FontIcon FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE91B;" />
            <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Photos" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            RowSpacing="8"
            Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Padding="24,16,24,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Photos" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,2"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh photos"
                    Click="Refresh_Click"
                    IsEnabled="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}"
                    ToolTipService.ToolTip="Refresh">
                    <Grid>
                        <FontIcon FontSize="14" Glyph="&#xE72C;" Visibility="{x:Bind ViewModel.IsNotLoading, Mode=OneWay}" />
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    </Grid>
                </Button>
            </Grid>

            <GridView
                x:Name="PhotoGrid"
                Grid.Row="1"
                Padding="20,0,20,16"
                AllowDrop="False"
                CanDragItems="True"
                ContainerContentChanging="PhotoGrid_ContainerContentChanging"
                DragItemsCompleted="PhotoGrid_DragItemsCompleted"
                DragItemsStarting="PhotoGrid_DragItemsStarting"
                IsItemClickEnabled="True"
                ItemClick="PhotoGrid_ItemClick"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="148"
                            ItemWidth="148"
                            Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.GroupStyle>
                    <GroupStyle HidesIfEmpty="True">
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="viewModels:PhotoGroupViewModel">
                                <TextBlock FontWeight="SemiBold" Text="{x:Bind Header, Mode=OneWay}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </GridView.GroupStyle>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="2" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="4" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:PhotoItemViewModel">
                        <Grid
                            Width="144"
                            Height="144"
                            AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            ContextRequested="Tile_ContextRequested"
                            CornerRadius="4">
                            <!--  Placeholder until the thumbnail arrives  -->
                            <FontIcon
                                FontSize="24"
                                Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                Glyph="&#xE91B;"
                                Visibility="{x:Bind ShowPlaceholder, Mode=OneWay}" />
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!--  The phone answered with no photos: the switch is off or access is missing  -->
            <StackPanel
                Grid.Row="1"
                MaxWidth="440"
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Spacing="8"
                Visibility="{x:Bind ViewModel.HasNoPhotos, Mode=OneWay}">
                <FontIcon FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE91B;" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Viewer  -->
        <Grid
            x:Name="Viewer"
            Grid.Row="1"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="8,8,12,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    AutomationProperties.Name="Back to photos"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CloseViewer_Click"
                    ToolTipService.ToolTip="Back to photos (Esc)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewerTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ViewerDetail"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button AutomationProperties.Name="Zoom out" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out">
                        <FontIcon FontSize="14" Glyph="&#xE71F;" />
                    </Button>
                    <Button AutomationProperties.Name="Zoom in" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in">
                        <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                    </Button>
                    <Button AutomationProperties.Name="Fit to window" Click="ZoomFit_Click" ToolTipService.ToolTip="Fit to window">
                        <FontIcon FontSize="14" Glyph="&#xE9A6;" />
                    </Button>
                    <AppBarSeparator />
                    <Button AutomationProperties.Name="Copy" Click="ViewerCopy_Click" ToolTipService.ToolTip="Copy">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                    </Button>
                    <Button AutomationProperties.Name="Save as" Click="ViewerSave_Click" ToolTipService.ToolTip="Save as...">
                        <FontIcon FontSize="14" Glyph="&#xE74E;" />
                    </Button>
                    <Button AutomationProperties.Name="Open with default app" Click="ViewerOpen_Click" ToolTipService.ToolTip="Open with default app">
                        <FontIcon FontSize="14" Glyph="&#xE8A7;" />
                    </Button>
                    <Button AutomationProperties.Name="Share" Click="ViewerShare_Click" ToolTipService.ToolTip="Share">
                        <FontIcon FontSize="14" Glyph="&#xE72D;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer
                    x:Name="ViewerScroll"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    MaxZoomFactor="8"
                    MinZoomFactor="1"
                    SizeChanged="ViewerScroll_SizeChanged"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    ZoomMode="Enabled">
                    <Image
                        x:Name="ViewerImage"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform" />
                </ScrollViewer>
                <ProgressRing
                    x:Name="ViewerProgress"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <TextBlock
                    x:Name="ViewerError"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="PreviousButton"
                    Width="40"
                    Height="40"
                    Margin="16,0,0,0"
                    Padding="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Previous photo"
                    Click="Previous_Click"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Newer">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Left" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <Button
                    x:Name="NextButton"
                    Width="40"
                    Height="40"
                    Margin="0,0,16,0"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Next photo"
                    Click="Next_Click"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Older">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Right" />
                    </Button.KeyboardAccelerators>
                    <FontIcon FontSize="14" Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
