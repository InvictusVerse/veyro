<?xml version="1.0" encoding="utf-8"?>
<!--
    Calls page (ADR-027, ADR-029). Left: the phone's call log and the call in progress. Right: a dial pad
    that places the call on the phone. Bindings come from CallsPageViewModel. Contact search is not part
    of Veyro's protocol yet.
-->
<Page
    x:Class="Veyro.Views.CallsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Veyro.Converters"
    xmlns:viewModels="using:Veyro.ViewModels"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  One key of the dial pad  -->
        <Style x:Key="KeypadKeyStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="MinHeight" Value="54" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiLight" />
        </Style>

        <!--  Round icon-only button without a frame  -->
        <Style x:Key="QuietIconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <!--  The phone is not paired or not connected  -->
        <StackPanel
            MaxWidth="440"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsUnavailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <FontIcon
                FontSize="36"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE717;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Calls" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.UnavailableText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnSpacing="0" Visibility="{x:Bind ViewModel.IsAvailable, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Call log and call in progress  -->
            <Grid
                Grid.Column="0"
                Padding="24,20,20,0"
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Calls" />
                        <TextBlock Style="{StaticResource RowHintStyle}" Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Refresh call history"
                        Click="Refresh_Click"
                        Style="{StaticResource QuietIconButtonStyle}"
                        ToolTipService.ToolTip="Refresh">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <!--  The call in progress, if any  -->
                <Border
                    Grid.Row="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Style="{StaticResource RowSurfaceStyle}"
                    Visibility="{x:Bind ViewModel.HasCurrentCall, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE717;" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind ViewModel.CurrentCallTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Style="{StaticResource RowHintStyle}"
                                Text="{x:Bind ViewModel.CurrentCallText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Click="Answer_Click"
                                Content="{x:Bind ViewModel.AnswerText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.IsRinging, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Click="Silence_Click"
                                Content="Silence"
                                Visibility="{x:Bind ViewModel.IsRinging, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Click="Decline_Click"
                                Content="Decline"
                                Visibility="{x:Bind ViewModel.IsRinging, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Click="End_Click"
                                Content="End call"
                                Visibility="{x:Bind ViewModel.IsInCall, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Progress and the result of the last action  -->
                <StackPanel Grid.Row="2" Spacing="8">
                    <TextBlock
                        Style="{StaticResource RowHintStyle}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ProgressBar
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <ListView
                    Grid.Row="3"
                    AutomationProperties.Name="Recent calls"
                    ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,0,12,0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:CallLogItemViewModel">
                            <Grid MinHeight="68" Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                    CornerRadius="20">
                                    <FontIcon
                                        AutomationProperties.Name="{x:Bind TypeText}"
                                        FontSize="16"
                                        Glyph="{x:Bind Glyph}"
                                        ToolTipService.ToolTip="{x:Bind TypeText}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource RowHintStyle}"
                                        Text="{x:Bind Number}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Visibility="{x:Bind HasNumberLine, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock
                                        Style="{StaticResource RowHintStyle}"
                                        Text="{x:Bind DetailText}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource RowHintStyle}"
                                    Text="{x:Bind TimeText}"
                                    TextWrapping="NoWrap" />

                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind CallLabel}"
                                    Click="CallBack_Click"
                                    IsEnabled="{x:Bind CanCall}"
                                    Style="{StaticResource QuietIconButtonStyle}"
                                    ToolTipService.ToolTip="Call on the phone">
                                    <FontIcon FontSize="14" Glyph="&#xE717;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="3"
                    MaxWidth="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoEntries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <!--  Dial pad  -->
            <Border
                Grid.Column="1"
                Width="312"
                Margin="0,20,24,24"
                Padding="18"
                VerticalAlignment="Top"
                Style="{StaticResource RowSurfaceStyle}">
                <StackPanel Spacing="14">
                    <TextBox
                        x:Name="DialBox"
                        AutomationProperties.Name="Number to dial"
                        FontSize="22"
                        KeyDown="DialBox_KeyDown"
                        MaxLength="64"
                        PlaceholderText="Enter a number"
                        Text="{x:Bind ViewModel.DialNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextAlignment="Center" />

                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Click="Key_Click" Content="1" Style="{StaticResource KeypadKeyStyle}" Tag="1" />
                        <Button Grid.Row="0" Grid.Column="1" Click="Key_Click" Content="2" Style="{StaticResource KeypadKeyStyle}" Tag="2" />
                        <Button Grid.Row="0" Grid.Column="2" Click="Key_Click" Content="3" Style="{StaticResource KeypadKeyStyle}" Tag="3" />
                        <Button Grid.Row="1" Grid.Column="0" Click="Key_Click" Content="4" Style="{StaticResource KeypadKeyStyle}" Tag="4" />
                        <Button Grid.Row="1" Grid.Column="1" Click="Key_Click" Content="5" Style="{StaticResource KeypadKeyStyle}" Tag="5" />
                        <Button Grid.Row="1" Grid.Column="2" Click="Key_Click" Content="6" Style="{StaticResource KeypadKeyStyle}" Tag="6" />
                        <Button Grid.Row="2" Grid.Column="0" Click="Key_Click" Content="7" Style="{StaticResource KeypadKeyStyle}" Tag="7" />
                        <Button Grid.Row="2" Grid.Column="1" Click="Key_Click" Content="8" Style="{StaticResource KeypadKeyStyle}" Tag="8" />
                        <Button Grid.Row="2" Grid.Column="2" Click="Key_Click" Content="9" Style="{StaticResource KeypadKeyStyle}" Tag="9" />
                        <Button Grid.Row="3" Grid.Column="0" Click="Key_Click" Content="*" Style="{StaticResource KeypadKeyStyle}" Tag="*" />
                        <Button
                            Grid.Row="3"
                            Grid.Column="1"
                            AutomationProperties.Name="0, right-click for plus"
                            Click="Key_Click"
                            RightTapped="ZeroKey_RightTapped"
                            Style="{StaticResource KeypadKeyStyle}"
                            Tag="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" Text="0" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.7"
                                    Text="+" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="3" Grid.Column="2" Click="Key_Click" Content="#" Style="{StaticResource KeypadKeyStyle}" Tag="#" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Call on the phone"
                            Click="Dial_Click"
                            CornerRadius="24"
                            IsEnabled="{x:Bind ViewModel.CanDial, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Call on the phone">
                            <FontIcon FontSize="18" Glyph="&#xE717;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="48"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Delete last digit"
                            Click="Backspace_Click"
                            Style="{StaticResource QuietIconButtonStyle}"
                            ToolTipService.ToolTip="Delete">
                            <FontIcon FontSize="18" Glyph="&#xE750;" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
