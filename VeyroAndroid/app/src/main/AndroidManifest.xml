<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Veyro requires NO Bluetooth and NO location permission. That is the whole point
         (ADR-001). If a future change needs either, it needs an ADR first. -->

    <!-- Local network sockets. Veyro never contacts a server on the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for ConnectivityManager.getActiveNetwork() / NetworkCallback.
         Without it the call throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for WifiManager.createMulticastLock(). Many OEM ROMs silently drop
         multicast packets without a held lock, and mDNS discovery then fails with no
         error at all (REQ-D03). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Wi-Fi Direct: high-speed peer-to-peer file transfer.
         NEARBY_WIFI_DEVICES on API 33+ with neverForLocation does not require location access.
         ACCESS_FINE_LOCATION capped at API 32 for legacy devices. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Transfers must survive the app going to background (REQ-T09). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- A multi-GB transfer with the screen off needs the CPU and the Wi-Fi radio awake.
         Acquired only for the duration of an active transfer, never while idle (NFR-03). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Progress and incoming-offer notifications. Runtime-requested on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VeyroApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyro"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- allowBackup=false is deliberate and security-relevant: the identity key is sealed
             by a non-exportable Android Keystore key, so a restored copy of the ciphertext
             would be undecryptable anyway, and cloning an identity to another device must not
             be possible (ProjectInfo/05-SECURITY.md section 4.4). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Veyro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
