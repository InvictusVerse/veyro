<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Veyro requires NO Bluetooth and NO location permission. That is the whole point
         (ADR-001). If a future change needs either, it needs an ADR first. -->

    <!-- Local network sockets. Veyro's own code never contacts a server on the internet. The
         Google code scanner used for QR pairing (ADR-030) bundles ML Kit, which may report
         usage diagnostics to Google through Play services. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required for ConnectivityManager.getActiveNetwork() / NetworkCallback.
         Without it the call throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for WifiManager.createMulticastLock(). Many OEM ROMs silently drop
         multicast packets without a held lock, and mDNS discovery then fails with no
         error at all (REQ-D03). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Wi-Fi Direct: high-speed peer-to-peer file transfer.
         NEARBY_WIFI_DEVICES on API 33+ with neverForLocation does not require location access.
         ACCESS_FINE_LOCATION capped at API 32 for legacy devices. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Transfers must survive the app going to background (REQ-T09). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- A multi-GB transfer with the screen off needs the CPU and the Wi-Fi radio awake.
         Acquired only for the duration of an active transfer, never while idle (NFR-03). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Background running (ADR-036): used only by the Settings button that explains why and asks;
         never requested on its own. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Progress and incoming-offer notifications. Runtime-requested on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the user grant Do Not Disturb access, which the PC needs to change this phone's
         ringer mode or DND (ADR-026). Granted in system settings, never assumed; every change is
         also behind the "Allow PC to ring and change sound mode" switch, off by default. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Messages and calls on the PC (ADR-027). Each is runtime-requested only when the user
         turns on "Messages and calls on PC" (off by default); nothing is read or sent without
         both the switch and the grant. GitHub build only: a Play build would move these to a
         separate flavor (ADR-027 point 5). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Photos on the PC (ADR-034). Runtime-requested only when the user turns on "Photos on PC"
         (off by default); only camera-roll and screenshot images are ever read. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Wallpaper on the PC (ADR-038): Android 14+ returns the wallpaper image only to apps with
         "All files access". Optional; asked for only from the "Show the exact wallpaper" row.
         Without it the PC gets a picture in the wallpaper's colours. GitHub build only. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- The permissions above would otherwise imply telephony hardware is required. Without it,
         the feature simply serves empty lists. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".VeyroApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyro"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- allowBackup=false is deliberate and security-relevant: the identity key is sealed
             by a non-exportable Android Keystore key, so a restored copy of the ciphertext
             would be undecryptable anyway, and cloning an identity to another device must not
             be possible (ProjectInfo/05-SECURITY.md section 4.4). -->

        <!-- QR pairing (ADR-030): ask Play services to fetch the code-scanner UI module at
             install time, so the first scan does not fail while it downloads. No CAMERA
             permission: the scanner runs inside Play services. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Veyro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accept / Decline on the incoming-file notification. Only our own PendingIntents reach it. -->
        <receiver
            android:name=".di.OfferActionReceiver"
            android:exported="false" />

    </application>

</manifest>
