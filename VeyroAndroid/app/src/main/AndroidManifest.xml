<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Veyro requires NO Bluetooth and NO location permission. That is the whole point
         (ADR-001). If a future change needs either, it needs an ADR first. -->

    <!-- Local network sockets. Veyro's own code never contacts a server on the internet. The
         Google code scanner used for QR pairing (ADR-030) bundles ML Kit, which may report
         usage diagnostics to Google through Play services. -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 17 (ADR-061): with targetSdk 37 every local network packet (TCP both ways, UDP
         multicast and broadcast, mDNS) is blocked until the user grants this. It is in the Nearby
         devices group with NEARBY_WIFI_DEVICES. Requested at runtime only on API 37+; older
         systems do not know it and ignore the declaration. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- Required for ConnectivityManager.getActiveNetwork() / NetworkCallback.
         Without it the call throws SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Required for WifiManager.createMulticastLock(). Many OEM ROMs silently drop
         multicast packets without a held lock, and mDNS discovery then fails with no
         error at all (REQ-D03). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Wi-Fi Direct: high-speed peer-to-peer file transfer.
         NEARBY_WIFI_DEVICES on API 33+ with neverForLocation does not require location access.
         ACCESS_FINE_LOCATION capped at API 32 for legacy devices. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />

    <!-- Transfers must survive the app going to background (REQ-T09). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- A multi-GB transfer with the screen off needs the CPU and the Wi-Fi radio awake.
         Acquired only for the duration of an active transfer, never while idle (NFR-03). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Background running (ADR-036): used only by the Settings button that explains why and asks;
         never requested on its own. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Progress and incoming-offer notifications. Runtime-requested on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the user grant Do Not Disturb access, which the PC needs to change this phone's
         ringer mode or DND (ADR-026). Granted in system settings, never assumed; every change is
         also behind the "Allow PC to ring and change sound mode" switch, off by default. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Screen brightness from the PC (ADR-060). A special access the user grants in system
         settings ("Modify system settings"), asked for only from Device settings; brightness is
         also behind "Let PCs control flashlight, volume and brightness", off by default. The
         flashlight (CameraManager.setTorchMode) and media volume need no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Messages and calls on the PC (ADR-027). Each is runtime-requested only when the user
         turns on "Messages and calls on PC" (off by default); nothing is read or sent without
         both the switch and the grant. GitHub build only: a Play build would move these to a
         separate flavor (ADR-027 point 5). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Photos on the PC (ADR-034). Runtime-requested only when the user turns on "Photos on PC"
         (off by default); only camera-roll and screenshot images are ever read. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Wallpaper on the PC (ADR-038): Android 14+ returns the wallpaper image only to apps with
         "All files access". Optional; asked for only from the "Show the exact wallpaper" row.
         Without it the PC gets a picture in the wallpaper's colours. GitHub build only. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Screen mirroring (ADR-066): Android grants playback capture (the sound apps play) only to
         apps holding this permission, which it labels "Microphone". Asked only when a PC asks
         for the phone's sound; Veyro never opens the microphone (AudioPlaybackCaptureConfiguration
         only). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <!-- The permissions above would otherwise imply telephony hardware is required. Without it,
         the feature simply serves empty lists. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- ADR-061: the phone makers' battery and autostart apps that "Keep Veyro connected" may
         open, so PackageManager can check a screen exists before it is offered (package visibility,
         Android 11+). Must match OemBackgroundGuide.allPackages; KeepAliveManifestTest checks it.
         Nothing is read from these apps. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.coloros.oppoguardelf" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.abe" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.hihonor.systemmanager" />
        <package android:name="com.asus.mobilemanager" />
    </queries>

    <application
        android:name=".VeyroApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Veyro"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- allowBackup=false is deliberate and security-relevant: the identity key is sealed
             by a non-exportable Android Keystore key, so a restored copy of the ciphertext
             would be undecryptable anyway, and cloning an identity to another device must not
             be possible (ProjectInfo/05-SECURITY.md section 4.4). -->

        <!-- QR pairing (ADR-030): ask Play services to fetch the code-scanner UI module at
             install time, so the first scan does not fail while it downloads. No CAMERA
             permission: the scanner runs inside Play services. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Veyro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- ADR-043: Direct Share targets ("Send to <PC>" in the share sheet's top row). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_targets" />
        </activity>

        <!-- Accept / Decline on the incoming-file notification. Only our own PendingIntents reach it. -->
        <receiver
            android:name=".di.OfferActionReceiver"
            android:exported="false" />

        <!-- ADR-044: Cancel on the "Receiving from <PC>" card. Only our own PendingIntents. -->
        <receiver
            android:name=".di.TransferActionReceiver"
            android:exported="false" />

        <!-- ADR-043, ADR-054: "Send with Veyro" in the share sheet (text, links, files) and in the
             text-selection menu. No UI of its own beyond a "Send to" chooser when several devices
             are connected: text goes straight to the device, files to ShareSendService.
             Exported because other apps start it; everything it receives is untrusted input. -->
        <activity
            android:name=".ShareToPcActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/send_with_veyro"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- ADR-043: sends files shared to Veyro in the background, holding their read grant for
             the whole transfer. Started only from ShareToPcActivity while it is visible. -->
        <service
            android:name=".ShareSendService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ADR-043: Copy on the "Copied on your PC" notification. Only our own PendingIntents. -->
        <receiver
            android:name=".di.ClipActionReceiver"
            android:exported="false" />

        <!-- ADR-062: Quick Settings tiles. Exported with BIND_QUICK_SETTINGS_TILE, so only the
             system can bind them. Not active tiles: bound only while the shade is open. -->
        <service
            android:name=".quick.SendClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_sym_content_paste"
            android:label="@string/tile_send_clipboard"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>
        <service
            android:name=".quick.SendFilesTileService"
            android:exported="true"
            android:icon="@drawable/ic_sym_upload"
            android:label="@string/tile_send_files"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>
        <service
            android:name=".quick.LockPcTileService"
            android:exported="true"
            android:icon="@drawable/ic_sym_lock"
            android:label="@string/tile_lock_pc"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_CATEGORY"
                android:value="android.service.quicksettings.CATEGORY_CONNECTIVITY" />
        </service>

        <!-- ADR-062: the Send clipboard tile's and widget's window. Android 10+ lets only the app
             with focus read the clipboard, so this transparent window takes focus, sends and
             closes. Started only by Veyro's own PendingIntents. -->
        <activity
            android:name=".quick.SendClipboardActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ADR-066: the transparent window behind Android's screen-capture and audio dialogs.
             Started only by Veyro's own notifications and code. -->
        <activity
            android:name=".mirror.MirrorConsentActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- ADR-066: Decline on the screen-sharing request. Only our own PendingIntents. -->
        <receiver
            android:name=".mirror.ScreenShareActionReceiver"
            android:exported="false" />

        <!-- ADR-062: the 4x1 home-screen widget. Exported because the launcher sends it updates. -->
        <receiver
            android:name=".quick.VeyroWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/veyro_widget_info" />
        </receiver>

        <!-- ADR-062: the widget's Lock PC. Only our own PendingIntents. -->
        <receiver
            android:name=".quick.QuickActionReceiver"
            android:exported="false" />

        <!-- ADR-043: hands an image from the PC to the system clipboard. Exposes cache/clips only. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clip_paths" />
        </provider>

    </application>

</manifest>
