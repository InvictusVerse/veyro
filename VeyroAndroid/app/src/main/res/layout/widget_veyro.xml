<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-062: the 4x1 home-screen widget. RemoteViews-safe views only. @android:id/background lets
     Android 12+ clip it to the launcher's widget shape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/widget_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:contentDescription="@string/widget_open_veyro"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_veyro_desktop"
            android:tint="@color/veyro_widget_on_surface" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/veyro_widget_on_surface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_not_connected"
                android:textColor="@color/veyro_widget_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_send_files"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/tile_send_files"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sym_upload"
        android:tint="@color/veyro_widget_on_button" />

    <ImageButton
        android:id="@+id/widget_send_clipboard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/tile_send_clipboard"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sym_content_paste"
        android:tint="@color/veyro_widget_on_button" />

    <ImageButton
        android:id="@+id/widget_lock"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/widget_button"
        android:contentDescription="@string/tile_lock_pc"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sym_lock"
        android:tint="@color/veyro_widget_on_button" />
</LinearLayout>
