<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-043: Direct Share. Each paired PC is a sharing shortcut ("Laptop") in the share sheet's top
     row, handled by ShareToPcActivity, so Veyro does not have to be found in the app list. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <share-target android:targetClass="com.veyro.ShareToPcActivity">
        <data android:mimeType="*/*" />
        <category android:name="com.veyro.category.SEND_TO_PC" />
    </share-target>
</shortcuts>
