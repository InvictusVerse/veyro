<?xml version="1.0" encoding="utf-8"?>
<!-- Primary pill on a notification card: the Veyro cyan-to-blue gradient. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#4404070F">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="0"
                android:endColor="#FF4F8FFF"
                android:startColor="#FF00D9FF" />
        </shape>
    </item>
</ripple>