<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary pill on a notification card. A neutral translucent fill reads on light and dark shades. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33888888">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="#26888888" />
            <stroke android:width="1dp" android:color="#33888888" />
        </shape>
    </item>
</ripple>