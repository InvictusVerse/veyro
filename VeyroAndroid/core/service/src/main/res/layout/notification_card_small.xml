<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed Veyro notification card (ADR-044): a gradient badge (or a thumbnail), title and line,
     an optional slim progress bar, and up to two pill buttons that work without expanding.
     Fits the 48 dp a decorated custom view gets when collapsed on Android 12+. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp">

        <ImageView
            android:id="@+id/card_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/card_glyph"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/card_thumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

            <TextView
                android:id="@+id/card_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textColor="@color/veyro_notif_accent"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/card_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <ProgressBar
            android:id="@+id/card_progress"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progressBackgroundTint="#33888888"
            android:progressTint="@color/veyro_notif_accent"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Round icon buttons: 36 dp each, so the title and line keep almost the full width. Their
         label is the content description, read by TalkBack and shown as text when expanded. -->
    <ImageView
        android:id="@+id/card_pill_1"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notif_button_primary"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/card_pill_2"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notif_button"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:visibility="gone" />
</LinearLayout>