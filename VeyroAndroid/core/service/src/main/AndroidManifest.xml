<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared in the module that owns the services, so the app manifest does not have to know
         about them. Manifest merging pulls these into :app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The background connection to the paired PC (ADR-036). Its API 34 runtime prerequisite is
         met by CHANGE_WIFI_MULTICAST_STATE below, a normal permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Only acts when the user turned on "Start on boot" (off by default). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <application>
        <!--
          connectedDevice: keeps the link to the paired PC open for as long as the user wants
          (ADR-036). dataSync would be capped at 6 h/day on Android 15 and could not start at boot.
        -->
        <service
            android:name="com.veyro.core.service.VeyroBackgroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Exported only because the system sends BOOT_COMPLETED and MY_PACKAGE_REPLACED; it
             checks the action and does nothing else. -->
        <receiver
            android:name="com.veyro.core.service.VeyroBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- ADR-061: Veyro itself was updated; same rules as boot. Only sent to this app. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
