; Veyro Link Protocol (VLP) v1 - CDDL schema
;
; This is the language-neutral, normative description of the bytes on the wire. It is the
; artefact the Windows client is written against, exactly as much as the Android client is.
; ProjectInfo/04-PROTOCOL.md is the prose specification; this file is the grammar.
;
; Rule: if this file and the Kotlin implementation disagree, this file and 04-PROTOCOL.md are
; right and the implementation has a bug. If all three disagree, that IS the bug report.
;
; Regenerate/verify mapping notes with: tools/verify-protocol.ps1

; =============================================================================================
; L0 - Presence. UNTRUSTED. Never proof of identity; produces candidate endpoints only.
; =============================================================================================

; mDNS TXT records for the _veyro._tcp service. Keys are short because mDNS packets are tiny and
; the TXT record is re-sent on every multicast response.
veyro-txt = {
  "v"    => uint,        ; protocol version. Must equal 1 for VLP v1.
  "id"   => tstr,        ; Crockford-Base32 deviceId, 26 chars.
  "pf"   => tstr,        ; "android" | "windows".
  "cap"  => uint,        ; capability bitfield, see capability-bits.
  "pk8"  => tstr,        ; hex, 8 bytes: SHA-256("veyro-pk-v1" ‖ staticPublic)[0..7].
  "tok"  => tstr,        ; hex, 8 bytes: rotating presence token. See below.
  ? "n"  => tstr,        ; display name. ABSENT in private mode; only in open/pairing mode.
  ? "p"  => uint,        ; TCP port. Present in UDP beacons; mDNS carries it in the SRV record.
}

capability-bits = uint .bits capability
capability = &(
  file-transfer: 1,
  folder-transfer: 2,
  resume: 4,
  clipboard: 8,
  sync: 16,
  handoff: 32,
  multi-stream: 64,
  compression: 128,
  ; Companion bits 0x0100..0x4000 are listed in 04-PROTOCOL.md section 6. Appended here:
  screen-source: 32768,     ; 0x8000, ADR-066 (phone; not advertised yet)
  screen-view: 65536,       ; 0x10000, ADR-066 (PC; not advertised yet)
  remote-input: 131072,     ; 0x20000, ADR-066 (reserved)
  phone-controls: 262144,   ; 0x40000, ADR-060
  device-info: 2097152,     ; 0x200000, ADR-059
)

; Presence token derivation:
;   epoch = floor(unixSeconds / 60)
;   tok   = HMAC-SHA256(key = pairingSecret, msg = "veyro-presence-v1" ‖ u64BE(epoch))[0..7]
; A browser tests each stored pairingSecret against `epoch` and `epoch-1` (clock skew).
; Open mode instead uses 8 random bytes regenerated per window, and it does advertise "n".

; UDP beacon, sent to 239.255.42.99:47653 and to each interface's directed broadcast.
; At most 1/second, and ONLY while a discovery window is open.
veyro-beacon = {
  magic:      h'56455952',   ; "VEYR"
  version:    uint .eq 1,
  type:       1 / 2,         ; 1 = QUERY, 2 = ANNOUNCE
  payloadLen: uint .le 65535,
  payload:    bstr .cbor veyro-txt,
}

; A QUERY MUST be answered with a unicast ANNOUNCE to the sender, never a broadcast.
; Broadcasting the answer turns one device joining a busy network into a reply storm.

; =============================================================================================
; L1 - Link protocol v3 (ADR-058). A WebSocket at /veyro carries text frames only. Normative
; prose: 04-PROTOCOL.md sections 4 and 5. Noise is not used and never was on the wire.
; =============================================================================================

; Primitives are fixed, with no negotiation and no downgrade path: X25519, ChaCha20-Poly1305,
; SHA-256, HKDF-SHA256, HMAC-SHA256. A v3 peer refuses any other protocolVersion.

b64-32 = tstr .size 44             ; standard base64 with padding of exactly 32 bytes

; First frame, initiator to responder. Cleartext; untrusted until keys confirm it.
link-preamble = {
  "id": tstr,                      ; canonical deviceId, compared byte for byte
  "name": tstr,
  "platform": "android" / "windows",
  "protocolVersion": 3,
  ? "pair": "confirm" / "qr",      ; absent = session with a stored pairing secret
  ? "pk": b64-32,                  ; static X25519 public key; required with pair
  "cn": b64-32,                    ; 32 fresh random bytes
  "epk": b64-32,                   ; this connection's ephemeral X25519 public key
}

; Second frame, responder to initiator. Cleartext.
link-preamble-ack = {
  "mode": "session" / "pairing" / "pairing-confirm" / "busy" / "refused",
  ? "reason": tstr,                ; refused / busy only
  ? "pk": b64-32,                  ; pairing and pairing-confirm
  ? "commit": b64-32,              ; pairing-confirm: SHA-256("veyro-commit-v1" || pkB || pkA || nB)
  ? "cn": b64-32,                  ; required with session, pairing, pairing-confirm
  ? "epk": b64-32,                 ; required with session, pairing, pairing-confirm
}

; Confirm pairing only: one cleartext nonce each way after the ack (A then B).
pair-nonce = { "t": "pairNonce", "n": b64-32 }

; Key schedule (04-PROTOCOL.md 4.1-4.6), over the exact preamble and ack bytes:
;   transcript = SHA-256(u32be(len P) || P || u32be(len A) || A)
;   dh         = X25519(e_local, epk_peer)
;   session:         ikm = dh || pairingSecret,            salt = transcript
;   pairing-confirm: ikm = dh || staticKey,                salt = SHA-256(transcript || nA || nB)
;   pairing (QR):    ikm = dh || staticKey || qrMix,       salt = transcript
;   staticKey  = HKDF(salt = transcript, ikm = X25519(static, pkPeer), info = "veyro-static-v3" 0 idI 0 idR)
;   kI2R, kR2I = HKDF-Expand(prk, label 0 "i2r"/"r2i" 0 idI 0 idR, 32)
;   expSecret (session) or chainKey (pairing) = HKDF-Expand(prk, label 0 "exp"/"chain" 0 idI 0 idR, 32)
;   after pairOk: prk = HKDF-Extract(transcript, chainKey || newPairingSecret), session labels

; Every later frame, in every mode, pairing included.
link-wire-frame = {
  "f": tstr,                       ; sender deviceId, must equal the peer's id byte for byte
  "c": tstr,                       ; base64(ChaCha20-Poly1305 ciphertext || 16-byte tag)
}
;   nonce = u32be(0) || u64be(counter); counter starts at 0 per direction and per key, implicit
;   aad   = utf8(f) || 0x00 || dir || u64be(counter); dir 0x01 initiator->responder, 0x02 back
;   One tag failure, a gap, or a repeat closes the connection.

; Plaintext of c.
link-envelope = {
  "v": 3,
  "msgId": tstr,
  "from": tstr,                    ; equals f
  "seq": uint,                     ; counter + 1
  "ts": uint,
  "payload": { "t": tstr, * tstr => any },
}

; QR pairing: pairHello carries the proof of the scanned secret.
;   qrProof = base64(HMAC-SHA256(HKDF-Expand(qrPrk, "veyro-qr-proof-v3", 32),
;                    "veyro-qr-proof-v3" 0 idPhone 0 idPc 0 transcript))
;   qrPrk   = HKDF-Extract("veyro-qr-v3", qrSecret)

; QR code content (out of band, format 2):
;   veyro:pair?v=2&id=<deviceId>&n=<name>&a=<ip:port>[,...4]&s=<qrSecret>&e=<unixSeconds>
;   s = 16 random bytes as 22 characters of unpadded base64url, canonical

; Key exporter (session mode only):
;   exportKey(label, ctx, L) = HKDF-Expand(expSecret,
;       u16be(15) || "veyro-export-v3" || u16be(len label) || label || u16be(len ctx) || ctx, L)

; =============================================================================================
; L2 - VTC3 data plane (raw TCP, 04-PROTOCOL.md 7.3). Big-endian integers.
; =============================================================================================

; Each data-socket attempt opens with one cleartext stream-open record per direction:
vtc3-stream-open = [
  magic: h'56544333',              ; "VTC3"
  type: 0x09,
  tidLen: uint .size 2, tid: bstr, ; UTF-8 transferId, 1..256 bytes
  seq: 0 .size 8,
  len: 16 .size 4,
  salt: bstr .size 16,             ; fresh random
]
;   okm = exportKey("veyro-vtc3", utf8(tid) || 0x00 || saltSender || saltReceiver, 64)
;   keyS2R = okm[0..32] (stream id 1), keyR2S = okm[32..64] (stream id 2)

; Every later record:
vtc3-record = [
  magic: h'56544333',
  type: uint .size 1,              ; the VTC frame type (auth, authAck, itemBegin, chunk, ...)
  tidLen: uint .size 2, tid: bstr,
  seq: uint .size 8,               ; equals the record counter; checked before decryption
  len: uint .size 4,               ; ciphertext length including the tag
  body: bstr,                      ; ChaCha20-Poly1305(payload), 16-byte tag at the end
]
;   nonce = u32be(streamId) || u64be(counter); aad = the 4+1+2+tidLen+8+4 header bytes
; NOTE: the CBOR sketch below predates the JSON wire. Control messages travel as JSON inside
; link-envelope (04-PROTOCOL.md section 6); this section is kept for the field numbering only.

; =============================================================================================
; Control messages: HISTORICAL CBOR sketch, not the wire format. Link protocol v3 (ADR-058)
; sends every control message as the JSON link-envelope above, sealed in a link-wire-frame.
; =============================================================================================

control-message = hello / hello-ack / transfer-offer / transfer-decision / item-begin /
                  item-end / item-result / transfer-end / cancel / error / ping / pong

hello = {
  0:  uint,        ; protocol version. Mismatch => Error{VERSION_UNSUPPORTED, fatal:true}.
  1:  tstr,        ; deviceId
  2:  tstr,        ; display name
  3:  tstr,        ; "android" | "windows"
  4:  tstr,        ; app version, for diagnostics only - never for behaviour
  5:  uint,        ; capability bitfield
  6:  uint,        ; maxChunk this side will accept
}

hello-ack = hello,                            ; same shape; add:
{
  7: uint,         ; chosen chunkSize = min(both maxChunk), clamped to [256 KiB, 16 MiB]
}

transfer-offer = {
  0: tstr,         ; transferId
  1: [* item],     ; items
  2: uint,         ; totalBytes, u64
  3: uint,         ; itemCount
}

item = {
  0: uint,         ; index
  1: tstr,         ; relPath - "/" separators, relative, validated per the rules below
  2: uint,         ; sizeBytes, u64
  3: uint,         ; mtimeMillis
  4: bool,         ; isDir
}

transfer-decision = {
  0: tstr,         ; transferId
  1: bool,         ; accept
  ? 2: tstr,       ; reason, when declined: "declined" | "timeout" | "busy" | "error" (free text, ADR-036)
  ? 3: { * uint => [* uint] },   ; itemIndex => chunk indices still needed (resume)
}

item-begin = { 0: tstr, 1: uint, 2: uint, 3: uint, 4: uint }
;              transferId, index, size, chunkCount, chunkSize

item-end    = { 0: tstr, 1: uint, 2: tstr }   ; transferId, index, sha256 hex of the whole file
item-result = { 0: tstr, 1: uint, 2: bool, ? 3: tstr }  ; transferId, index, ok, error
transfer-end = { 0: tstr, 1: bool, 2: [* uint] }        ; transferId, completed, failedIndices

cancel = { 0: tstr, 1: tstr }                 ; transferId, reason
error  = { 0: tstr, 1: tstr, 2: bool }        ; code, message, fatal
ping   = { 0: uint }                          ; nonce
pong   = { 0: uint }                          ; the same nonce, echoed

; Reserved for phase P6 (Veyro Clipboard), declared now so the number is not reused:
; clipboard-push = { 0: tstr }   ; text, size-capped, per-device opt-in

; =============================================================================================
; Companion JSON messages (session frames, "t" discriminator, nulls omitted). Additions only;
; the full list is in 04-PROTOCOL.md section 6.
; =============================================================================================

; ADR-059, gated by device-info. Either direction, on connect and on every change. Each field
; is applied on its own; a name that fails the rule below is ignored.
device-info = {
  "t": "deviceInfo",
  ? "name": device-name,        ; the sender's own name
  ? "clipReceive": bool,        ; phone only: "Auto-fetch clipboard" is on
}
device-name = tstr .size (1..64) ; after trimming; no C0/C1 control, U+2028/2029, U+202A-202E, U+2066-2069

; ADR-066, gated by screen-source (phone) and screen-view (PC). The PC decides every quality
; setting; the phone reports caps and consent, asks Android, and encodes what the PC asked for.
; Vectors: protocol/testvectors/link-stream.json. Media itself travels on VMS1 (below).
stream-sid = tstr .regexp "^[A-Za-z0-9_-]{22}$"   ; base64url of 16 bytes, canonical
stream-codec = "h264" / "h265"
stream-reason = "user" / "declined" / "timeout" / "busy" / "disabled" / "permission" /
                "unsupported" / "projection-ended" / "locked" / "thermal" / "encoder" /
                "network" / "session-closed" / "error"
stream-caps = { "t": "streamCaps", ? "allowed": bool, ? "screen": { "w": 16..8192, "h": 16..8192, "maxFps": 1..240 },
                ? "encoders": [* { "codec": tstr, "hw": bool, "maxW": 16..8192, "maxH": 16..8192, "fps": 1..240 }], ? "audio": bool }
stream-start = { "t": "streamStart", "sid": stream-sid, "source": "screen", "codec": stream-codec, "hw": bool,
                 "maxLong": 160..3840, "fps": 1..120, "bitrate": 250000..80000000, ? "audio": bool,
                 "host": tstr, "port": 1024..65535 }               ; host: private IPv4 only
stream-state = { "t": "streamState", "sid": stream-sid,
                 "state": "asking" / "starting" / "streaming" / "paused" / "stopped", ? "reason": stream-reason,
                 ? "codec": stream-codec, ? "w": 16..8192, ? "h": 16..8192, ? "fps": 1..240,
                 ? "bitrate": 0..80000000, ? "hw": bool, ? "audio": bool, ? "thermal": 0..6 }
stream-config = { "t": "streamConfig", "sid": stream-sid, ? "maxLong": 160..3840, ? "fps": 1..120,
                  ? "bitrate": 250000..80000000, ? "audio": bool, ? "paused": bool }
stream-keyframe = { "t": "streamKeyframe", "sid": stream-sid }
stream-stop = { "t": "streamStop", "sid": stream-sid, "reason": stream-reason }

; VMS1 media socket (binary, ADR-066, 04-PROTOCOL.md 7.5). Not CBOR or JSON; described here so
; every wire format has one index. preface = "VMS1" u8(1) u8(source) u16(0) sid[16] salt[16];
; record = u8 kind | u8 flags | u32 len | ChaCha20-Poly1305 ciphertext||tag (len bytes), AAD = the
; 6 header bytes. Vectors: protocol/testvectors/media/vms1.json, fragmentation.json, stream-geometry.json.
; ADR-060, gated by phone-controls (and device-status). Optional additions to devStatus
; (phone to PC) and devControl (PC to phone); never between phones.
dev-status-phone-controls = (
  ? "torch": bool,
  ? "mediaVolume": 0..100,
  ? "brightness": 0..100,
  ? "autoBrightness": bool,
  ? "controls": { ? "torch": control-state, ? "volume": control-state, ? "brightness": control-state },
)
control-state = "ok" / "off" / "permission" / "unsupported" / "busy"   ; unknown = not available
dev-control-phone-controls = (
  ? "torch": bool,
  ? "mediaVolume": 0..100,      ; outside the range: ignored by the phone
  ? "brightness": 0..100,       ; also turns automatic brightness off
  ? "autoBrightness": bool,
)
; =============================================================================================
; Convergence rules
; =============================================================================================

; An unknown device pairs only by confirm code (accepted on the other screen) or by a QR code
; while the PC's bounded (5 min) pairing window is open; an unknown device without pair is
; refused ("not-paired"). A failure before the first authenticated frame closes without detail.

; Replay: both sides contribute a fresh ephemeral key and cn to every connection, so a recorded
; connection cannot be replayed into a new one. Frame counters are per direction and strictly
; increasing, and a session is registered only after the peer's first authenticated frame.

; Additive compatibility: unknown keys MUST be ignored, never rejected. Adding an optional key is
; allowed within a version; removing one or changing its meaning requires a version bump.

; =============================================================================================
; Path safety - the destination-path grammar a relPath MUST satisfy (REQ-T11)
; =============================================================================================

valid-rel-path = tstr .regexp "^[^/\\\\<>:\"|?*\\x00-\\x1f\\x7f]+(/[^/\\\\<>:\"|?*\\x00-\\x1f\\x7f]+)*$"
; Plus, checked structurally and not expressible as a single regex:
;   - 1..64 segments, whole thing <= 1024 UTF-8 bytes, well-formed UTF-16 (no lone surrogates)
;   - no segment equal to "." or ".."
;   - no segment ending in "." or " " (Windows silently strips these, aliasing files)
;   - no segment whose stem (before the first ".") is a Windows reserved name:
;     CON PRN AUX NUL COM1-9 LPT1-9, case-insensitive
;   - the resolved absolute target must still be inside the destination directory
;
; Validation lives in exactly one implementation, shared by Android and Windows:
; core/protocol/src/main/kotlin/com/veyro/core/protocol/RelativePath.kt
