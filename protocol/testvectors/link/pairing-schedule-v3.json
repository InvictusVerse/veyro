{
  "description": "Link protocol v3 pairing key schedules (ProjectInfo/04-PROTOCOL.md sections 4.2-4.5, ADR-058): confirm-code pairing and QR pairing, then the switch to session keys after pairOk. A = phone = initiator, B = PC = responder; static keys are the RFC 7748 6.1 pair (pair-confirm.json).",
  "algorithm": {
    "staticKey": "HKDF-SHA256(ikm = X25519(staticPrivate_self, pk_peer), salt = transcript, info = utf8(\"veyro-static-v3\") || 0x00 || utf8(idI) || 0x00 || utf8(idR), 32)",
    "confirm": "salt = SHA-256(transcript || nA || nB); ikm = dh || staticKey; label veyro-pair-confirm-v3",
    "qr": "salt = transcript; ikm = dh || staticKey || qrMix; label veyro-pair-qr-v3",
    "keys": "prk = HKDF-Extract(salt, ikm); kI2r, kR2i, chainKey = HKDF-Expand(prk, info(label, i2r | r2i | chain), 32)",
    "afterPairOk": "prkSession = HKDF-Extract(salt = transcript, ikm = chainKey || newPairingSecret); session kI2r, kR2i, expSecret with label veyro-link-v3",
    "qrSecret": "qrPrk = HKDF-Extract(utf8(\"veyro-qr-v3\"), qrSecret); proofKey = HKDF-Expand(qrPrk, \"veyro-qr-proof-v3\", 32); qrMix = HKDF-Expand(qrPrk, \"veyro-qr-mix-v3\", 32)",
    "qrProof": "HMAC-SHA256(proofKey, utf8(\"veyro-qr-proof-v3\") || 0x00 || utf8(idPhone) || 0x00 || utf8(idPc) || 0x00 || transcript)"
  },
